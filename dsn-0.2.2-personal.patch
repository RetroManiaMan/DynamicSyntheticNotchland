diff --git a/src/background/art.ts b/src/background/art.ts
new file mode 100644
index 0000000..235e0c9
--- /dev/null
+++ b/src/background/art.ts
@@ -0,0 +1,77 @@
+import { extractAccent } from '../shared/color.ts'
+import type { ArtResult } from '../shared/protocol.ts'
+
+const MAX_BYTES = 6 * 1024 * 1024
+const MAX_ENTRIES = 24
+const FAILURE_TTL_MS = 30_000
+
+const cache = new Map<string, { value: ArtResult | null; at: number }>()
+const inflight = new Map<string, Promise<ArtResult | null>>()
+
+/**
+ * Fetches artwork once (here, not in every tab), derives the accent and a small thumbnail, and caches by URL.
+ * Tabs receive the result through the hub, so no page ever loads another site's artwork on DSN's behalf.
+ */
+export function resolveArt(url: string): Promise<ArtResult | null> {
+  const hit = cache.get(url)
+  if (hit && (hit.value || Date.now() - hit.at < FAILURE_TTL_MS)) {
+    cache.delete(url); cache.set(url, hit) // refresh LRU position
+    return Promise.resolve(hit.value)
+  }
+  const pending = inflight.get(url)
+  if (pending) return pending
+  const task = load(url).catch(() => null).then((value) => {
+    inflight.delete(url)
+    cache.set(url, { value, at: Date.now() })
+    while (cache.size > MAX_ENTRIES) cache.delete(cache.keys().next().value as string)
+    return value
+  })
+  inflight.set(url, task)
+  return task
+}
+
+function allowed(url: string): boolean {
+  try {
+    const u = new URL(url)
+    if (u.protocol === 'http:' || u.protocol === 'https:') return true
+    return u.protocol === 'data:' && /^data:image\//i.test(url)
+  } catch {
+    return false
+  }
+}
+
+function drawCover(bitmap: ImageBitmap, size: number): OffscreenCanvas {
+  const canvas = new OffscreenCanvas(size, size)
+  const ctx = canvas.getContext('2d', { willReadFrequently: true })!
+  const scale = Math.max(size / bitmap.width, size / bitmap.height)
+  const w = bitmap.width * scale, h = bitmap.height * scale
+  ctx.drawImage(bitmap, (size - w) / 2, (size - h) / 2, w, h)
+  return canvas
+}
+
+function toBase64(bytes: Uint8Array): string {
+  let binary = ''
+  for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000))
+  return btoa(binary)
+}
+
+async function load(url: string): Promise<ArtResult | null> {
+  if (!allowed(url)) return null
+  const response = await fetch(url, { credentials: 'omit', referrerPolicy: 'no-referrer', signal: AbortSignal.timeout(8000) })
+  if (!response.ok) return null
+  const type = response.headers.get('content-type') ?? ''
+  if (type && !type.toLowerCase().startsWith('image/')) return null
+  if (Number(response.headers.get('content-length') ?? 0) > MAX_BYTES) return null
+  const blob = await response.blob()
+  if (blob.size > MAX_BYTES || blob.size === 0) return null
+
+  const bitmap = await createImageBitmap(blob) // rejects for undecodable formats (e.g. SVG in a worker)
+  try {
+    const pixels = drawCover(bitmap, 48).getContext('2d', { willReadFrequently: true })!.getImageData(0, 0, 48, 48).data
+    const accent = extractAccent(pixels)
+    const thumbBlob = await drawCover(bitmap, 160).convertToBlob({ type: 'image/webp', quality: 0.82 })
+    return { accent, thumb: toBase64(new Uint8Array(await thumbBlob.arrayBuffer())) }
+  } finally {
+    bitmap.close()
+  }
+}
diff --git a/src/background/focus.ts b/src/background/focus.ts
new file mode 100644
index 0000000..704ac61
--- /dev/null
+++ b/src/background/focus.ts
@@ -0,0 +1,45 @@
+import { isBlockedHost, normalizeHost } from '../shared/hosts.ts'
+import { loadSettings, type FocusSettings } from '../shared/settings.ts'
+
+const RULE_BASE = 1000
+const APPLIED_KEY = 'dsn-focus-applied-v1' // session storage: the focus config the current rules were built from
+
+/** Mirrors Focus Mode into declarativeNetRequest redirects. Idempotent; skips work when nothing changed. */
+export async function syncFocusRules(force = false): Promise<void> {
+  const { focus } = await loadSettings()
+  const signature = JSON.stringify(focus)
+  if (!force) {
+    const applied = (await chrome.storage.session.get(APPLIED_KEY))[APPLIED_KEY]
+    if (applied === signature) return
+  }
+  const existing = await chrome.declarativeNetRequest.getDynamicRules()
+  const addRules: chrome.declarativeNetRequest.Rule[] = focus.enabled
+    ? focus.sites.map((host, index) => ({
+        id: RULE_BASE + index,
+        priority: 1,
+        action: {
+          type: chrome.declarativeNetRequest.RuleActionType.REDIRECT,
+          redirect: { extensionPath: `/blocked.html?site=${encodeURIComponent(host)}&strict=${focus.strict ? 1 : 0}` },
+        },
+        condition: { requestDomains: [host], resourceTypes: [chrome.declarativeNetRequest.ResourceType.MAIN_FRAME] },
+      }))
+    : []
+  await chrome.declarativeNetRequest.updateDynamicRules({ removeRuleIds: existing.map((rule) => rule.id), addRules })
+  // Config changed, so previously granted "continue anyway" passes no longer apply.
+  const session = await chrome.declarativeNetRequest.getSessionRules()
+  if (session.length) await chrome.declarativeNetRequest.updateSessionRules({ removeRuleIds: session.map((rule) => rule.id) })
+  await chrome.storage.session.set({ [APPLIED_KEY]: signature })
+}
+
+/** "Continue anyway" on the blocked page. Refused in strict mode or for hosts that are not on the list. */
+export async function allowHostForSession(rawHost: string): Promise<boolean> {
+  const host = normalizeHost(rawHost)
+  const focus: FocusSettings = (await loadSettings()).focus
+  if (!host || !focus.enabled || focus.strict || !isBlockedHost(host, focus.sites)) return false
+  const session = await chrome.declarativeNetRequest.getSessionRules()
+  const id = Math.max(100_000, ...session.map((rule) => rule.id + 1))
+  await chrome.declarativeNetRequest.updateSessionRules({
+    addRules: [{ id, priority: 2, action: { type: chrome.declarativeNetRequest.RuleActionType.ALLOW }, condition: { requestDomains: [host], resourceTypes: [chrome.declarativeNetRequest.ResourceType.MAIN_FRAME] } }],
+  })
+  return true
+}
diff --git a/src/background/hub.ts b/src/background/hub.ts
new file mode 100644
index 0000000..e37392d
--- /dev/null
+++ b/src/background/hub.ts
@@ -0,0 +1,132 @@
+import { HUB_KEY, MEDIA_ACTIONS, type Capabilities, type HubStored, type MediaAction, type SessionView, type SourceSnapshot } from '../shared/protocol.ts'
+import { resolveArt } from './art.ts'
+
+/**
+ * The hub keeps every tab's media session and mirrors them into chrome.storage.session.
+ * There are no long-lived ports: tabs report with one-off messages and every notch simply watches storage,
+ * so a terminated service worker loses nothing and no tab has to reconnect.
+ */
+const entries = new Map<string, SessionView>()
+let rev = 0
+
+export const ready: Promise<void> = (async () => {
+  // Content scripts must be able to read session storage to observe the hub.
+  await chrome.storage.session.setAccessLevel({ accessLevel: 'TRUSTED_AND_UNTRUSTED_CONTEXTS' })
+  const stored = (await chrome.storage.session.get(HUB_KEY))[HUB_KEY] as HubStored | undefined
+  for (const session of stored?.sessions ?? []) entries.set(session.key, session)
+  rev = stored?.rev ?? 0
+})()
+
+async function publish(): Promise<void> {
+  rev += 1
+  await chrome.storage.session.set({ [HUB_KEY]: { sessions: [...entries.values()], rev } satisfies HubStored })
+}
+
+const str = (value: unknown, max: number) => (typeof value === 'string' ? value.slice(0, max) : '')
+const num = (value: unknown, fallback: number, min = -Infinity, max = Infinity) =>
+  typeof value === 'number' && Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : fallback
+const flag = (value: unknown) => value === true
+
+function safeArtwork(value: unknown): string | null {
+  if (typeof value !== 'string' || !value) return null
+  try {
+    const url = new URL(value)
+    if (url.protocol === 'http:' || url.protocol === 'https:') return value.length <= 2048 ? value : null
+    return url.protocol === 'data:' && /^data:image\//i.test(value) && value.length <= 300_000 ? value : null
+  } catch {
+    return null
+  }
+}
+
+/** Never trust page-originated data: clamp, type-check, and default everything. */
+export function sanitizeSnapshot(raw: unknown): SourceSnapshot | null {
+  if (!raw || typeof raw !== 'object') return null
+  const r = raw as Record<string, any>
+  const caps = (r.caps && typeof r.caps === 'object' ? r.caps : {}) as Record<string, unknown>
+  const capabilities: Capabilities = { play: flag(caps.play), seek: flag(caps.seek), previous: flag(caps.previous), next: flag(caps.next), volume: flag(caps.volume), repeat: flag(caps.repeat) }
+  const title = str(r.title, 200).trim()
+  if (!title) return null
+  const pageUrl = typeof r.pageUrl === 'string' && /^https?:\/\//i.test(r.pageUrl) ? r.pageUrl.slice(0, 2048) : ''
+  return {
+    title, artist: str(r.artist, 200), album: str(r.album, 200), artworkUrl: safeArtwork(r.artworkUrl),
+    playing: flag(r.playing), position: num(r.position, 0, 0, 86_400 * 7), at: num(r.at, Date.now()),
+    duration: r.duration === null ? null : num(r.duration, 0, 0, 86_400 * 7) || null,
+    rate: num(r.rate, 1, 0.0625, 16), muted: flag(r.muted), volume: num(r.volume, 1, 0, 1), repeat: flag(r.repeat),
+    caps: capabilities, host: str(r.host, 253), pageUrl,
+  }
+}
+
+export async function onSnapshot(sender: chrome.runtime.MessageSender, raw: unknown): Promise<void> {
+  await ready
+  const snap = sanitizeSnapshot(raw)
+  const tabId = sender.tab?.id, windowId = sender.tab?.windowId
+  if (!snap || !Number.isInteger(tabId) || !Number.isInteger(windowId)) return
+  const frameId = sender.frameId ?? 0
+  const key = `${tabId}:${frameId}`
+  const prev = entries.get(key)
+  const now = Date.now()
+  const sameTrack = !!prev && prev.title === snap.title && prev.artist === snap.artist && prev.artworkUrl === snap.artworkUrl
+  const art = prev && prev.artworkUrl === snap.artworkUrl ? prev.art : snap.artworkUrl ? undefined : null
+  const view: SessionView = {
+    ...snap, key, tabId: tabId!, windowId: windowId!, frameId, lastSeen: now,
+    updatedAt: prev && sameTrack && prev.playing === snap.playing ? prev.updatedAt : now,
+    art,
+  }
+  entries.set(key, view)
+  await publish()
+  if (view.art === undefined && view.artworkUrl) {
+    const url = view.artworkUrl
+    void resolveArt(url).then(async (result) => {
+      await ready
+      const current = entries.get(key)
+      if (current && current.artworkUrl === url && current.art === undefined) {
+        current.art = result
+        await publish()
+      }
+    })
+  }
+}
+
+export async function removeWhere(predicate: (session: SessionView) => boolean): Promise<void> {
+  await ready
+  let changed = false
+  for (const [key, session] of entries) if (predicate(session)) { entries.delete(key); changed = true }
+  if (changed) await publish()
+}
+
+export async function onGone(sender: chrome.runtime.MessageSender): Promise<void> {
+  const tabId = sender.tab?.id, frameId = sender.frameId ?? 0
+  await removeWhere((session) => session.tabId === tabId && session.frameId === frameId)
+}
+
+export async function getSessions(): Promise<HubStored> {
+  await ready
+  return { sessions: [...entries.values()], rev }
+}
+
+export async function control(key: string, action: MediaAction, value?: number | boolean): Promise<boolean> {
+  await ready
+  const session = entries.get(key)
+  if (!session || !MEDIA_ACTIONS.includes(action)) return false
+  if (value !== undefined && typeof value !== 'number' && typeof value !== 'boolean') return false
+  try {
+    await chrome.tabs.sendMessage(session.tabId, { t: 'command', action, value }, { frameId: session.frameId })
+    return true
+  } catch {
+    return false
+  }
+}
+
+/** Brings the tab (and its window) that owns the media to the front. */
+export async function focusSource(key: string): Promise<boolean> {
+  await ready
+  const session = entries.get(key)
+  if (!session) return false
+  try {
+    await chrome.tabs.update(session.tabId, { active: true })
+    await chrome.windows.update(session.windowId, { focused: true })
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/src/background/index.ts b/src/background/index.ts
new file mode 100644
index 0000000..95b7ed7
--- /dev/null
+++ b/src/background/index.ts
@@ -0,0 +1,57 @@
+import type { ToWorker } from '../shared/protocol.ts'
+import { SETTINGS_KEY } from '../shared/settings.ts'
+import { allowHostForSession, syncFocusRules } from './focus.ts'
+import { control, focusSource, getSessions, onGone, onSnapshot, removeWhere } from './hub.ts'
+import { fetchLyrics } from './lyrics.ts'
+
+chrome.runtime.onInstalled.addListener(() => { void syncFocusRules(true) })
+chrome.runtime.onStartup.addListener(() => { void syncFocusRules() })
+void syncFocusRules().catch(() => {})
+
+chrome.action.onClicked.addListener(() => { void chrome.runtime.openOptionsPage() })
+
+chrome.storage.onChanged.addListener((changes, area) => {
+  if (area === 'local' && changes[SETTINGS_KEY]) void syncFocusRules().catch(() => {})
+})
+
+// A navigating or closing tab ends its sessions. A paused session is never removed for being paused.
+chrome.tabs.onRemoved.addListener((tabId) => { void removeWhere((session) => session.tabId === tabId) })
+chrome.tabs.onUpdated.addListener((tabId, info) => {
+  if (info.status === 'loading') void removeWhere((session) => session.tabId === tabId)
+})
+
+function safeUrl(value: unknown): string | null {
+  try {
+    const url = new URL(String(value))
+    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null
+  } catch {
+    return null
+  }
+}
+
+async function handle(message: ToWorker, sender: chrome.runtime.MessageSender): Promise<unknown> {
+  switch (message.t) {
+    case 'snapshot': await onSnapshot(sender, message.snap); return { ok: true }
+    case 'gone': await onGone(sender); return { ok: true }
+    case 'hub:get': return getSessions()
+    case 'control': return { ok: await control(String(message.key), message.action, message.value) }
+    case 'focus': return { ok: await focusSource(String(message.key)) }
+    case 'lyrics': return fetchLyrics({ title: String(message.title ?? ''), artist: String(message.artist ?? ''), album: String(message.album ?? ''), duration: typeof message.duration === 'number' ? message.duration : null })
+    case 'open-settings': await chrome.runtime.openOptionsPage(); return { ok: true }
+    case 'focus-allow': return { ok: await allowHostForSession(String(message.host ?? '')) }
+    case 'browser-action': {
+      if (message.action?.type === 'newtab') { await chrome.tabs.create({}); return { ok: true } }
+      const url = message.action?.type === 'open' ? safeUrl(message.action.url) : null
+      if (!url) return { ok: false }
+      await chrome.tabs.create({ url })
+      return { ok: true }
+    }
+    default: return { ok: false }
+  }
+}
+
+chrome.runtime.onMessage.addListener((message: ToWorker, sender, sendResponse) => {
+  if (sender.id !== chrome.runtime.id || !message || typeof message !== 'object') return
+  handle(message, sender).then(sendResponse, () => sendResponse({ ok: false }))
+  return true
+})
diff --git a/src/background/lyrics.ts b/src/background/lyrics.ts
new file mode 100644
index 0000000..18f8356
--- /dev/null
+++ b/src/background/lyrics.ts
@@ -0,0 +1,71 @@
+import { parseLrc } from '../shared/lrc.ts'
+import type { LyricsResult } from '../shared/protocol.ts'
+import { loadSettings } from '../shared/settings.ts'
+
+/** Replaced at build time. Production: https://lrclib.net/api. Tests point it at a local stub. */
+declare const __LRCLIB_BASE__: string
+
+const OK_TTL = 30 * 60_000
+const MISS_TTL = 5 * 60_000
+const cache = new Map<string, { value: LyricsResult; at: number }>()
+
+/** Strips the decoration video titles add ("(Official Video)", "[Lyrics]", "- Topic"). */
+export function cleanTitle(title: string): string {
+  return title
+    .replace(/\s*[([][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|remaster(ed)?|hd|4k|live)\b[^)\]]*[)\]]/gi, '')
+    .replace(/\s{2,}/g, ' ')
+    .trim()
+}
+export const cleanArtist = (artist: string) => artist.replace(/\s*-\s*topic$/i, '').trim()
+
+interface LrclibRecord { duration?: number; syncedLyrics?: string | null; plainLyrics?: string | null }
+
+function toResult(record: LrclibRecord | undefined): LyricsResult {
+  if (!record) return { status: 'not-found', synced: null, plain: null }
+  const synced = record.syncedLyrics ? parseLrc(record.syncedLyrics) : []
+  const plain = record.plainLyrics?.trim() || null
+  if (!synced.length && !plain) return { status: 'not-found', synced: null, plain: null }
+  return { status: 'ok', synced: synced.length ? synced : null, plain }
+}
+
+async function getJson(url: URL): Promise<unknown | null> {
+  const response = await fetch(url, { credentials: 'omit', referrerPolicy: 'no-referrer', signal: AbortSignal.timeout(8000) })
+  if (response.status === 404) return null
+  if (!response.ok) throw new Error(`lyrics provider returned ${response.status}`)
+  return response.json()
+}
+
+/** Only runs when the person opted in (Settings > Media) and opened lyrics for the current track. */
+export async function fetchLyrics(input: { title: string; artist: string; album: string; duration: number | null }): Promise<LyricsResult> {
+  if (!(await loadSettings()).lyricsEnabled) return { status: 'disabled', synced: null, plain: null }
+  const title = cleanTitle(input.title), artist = cleanArtist(input.artist)
+  if (!title) return { status: 'not-found', synced: null, plain: null }
+
+  const key = `${title}\u0001${artist}\u0001${Math.round(input.duration ?? 0)}`
+  const hit = cache.get(key)
+  if (hit && Date.now() - hit.at < (hit.value.status === 'ok' ? OK_TTL : MISS_TTL)) return hit.value
+
+  try {
+    const exact = new URL(`${__LRCLIB_BASE__}/get`)
+    exact.searchParams.set('track_name', title)
+    if (artist) exact.searchParams.set('artist_name', artist)
+    if (input.album) exact.searchParams.set('album_name', input.album)
+    if (input.duration) exact.searchParams.set('duration', String(Math.round(input.duration)))
+    let record = (await getJson(exact)) as LrclibRecord | null
+
+    if (!record) {
+      const search = new URL(`${__LRCLIB_BASE__}/search`)
+      search.searchParams.set('track_name', title)
+      if (artist) search.searchParams.set('artist_name', artist)
+      const list = ((await getJson(search)) as LrclibRecord[] | null) ?? []
+      const close = input.duration ? list.filter((r) => typeof r.duration === 'number' && Math.abs(r.duration - input.duration!) <= 5) : list
+      record = close.find((r) => r.syncedLyrics) ?? close.find((r) => r.plainLyrics) ?? null
+    }
+    const value = toResult(record ?? undefined)
+    cache.set(key, { value, at: Date.now() })
+    while (cache.size > 50) cache.delete(cache.keys().next().value as string)
+    return value
+  } catch {
+    return { status: 'error', synced: null, plain: null }
+  }
+}

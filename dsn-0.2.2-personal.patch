+/** Shadow-DOM stylesheet. Brand green is --green; the media-driven accent is --dsn-accent (only media UI uses it). */
+export const CSS = `
+:host { all: initial; }
+*, *::before, *::after { box-sizing: border-box; }
+[hidden] { display: none !important; }
+button, input { font: inherit; color: inherit; }
+button { padding: 0; border: 0; background: none; cursor: pointer; }
+button:disabled { cursor: not-allowed; }
+:focus-visible { outline: 2px solid rgb(var(--green-rgb) / .85); outline-offset: 2px; }
+
+.dsn-anchor {
+  --green: #d4f11e; --green-rgb: 212 241 30;
+  --dsn-accent: #d4f11e; --dsn-accent-rgb: 212 241 30;
+  --surface-a: rgba(20,20,22,.94); --surface-b: rgba(10,10,12,.92);
+  --ease: cubic-bezier(.22,1,.36,1);
+  position: fixed; z-index: 2147483647; display: flex; justify-content: center; pointer-events: none; user-select: none;
+  color: rgba(255,255,255,.96); font: 14px ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased;
+}
+.dsn-anchor[data-placement="top"]    { top: 10px; left: 50%; transform: translateX(-50%); }
+.dsn-anchor[data-placement="bottom"] { bottom: 10px; left: 50%; transform: translateX(-50%); align-items: flex-end; }
+.dsn-anchor[data-placement="left"]   { left: 10px; top: 50%; transform: translateY(-50%); }
+.dsn-anchor[data-placement="right"]  { right: 10px; top: 50%; transform: translateY(-50%); }
+.dsn-anchor[data-placement="free"]   { left: var(--fx, 50%); top: var(--fy, 10px); transform: translateX(-50%); }
+.dsn-anchor[data-dragging="true"] .dsn-shell { transition: none; cursor: grabbing; }
+.dsn-anchor[data-amoled="true"] { --surface-a: #000; --surface-b: #000; }
+
+.dsn-shell {
+  --w: 200px; --r: 20px; --wash: none; --glow: 0 0 0 transparent;
+  width: var(--w); max-width: calc(100vw - 16px); overflow: hidden; pointer-events: auto;
+  border: 1px solid rgba(255,255,255,.08); border-radius: var(--r);
+  background: var(--wash), linear-gradient(180deg, var(--surface-a), var(--surface-b));
+  box-shadow: 0 8px 32px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.03), inset 0 1px 0 rgba(255,255,255,.06), var(--glow);
+  backdrop-filter: blur(20px) saturate(1.2);
+  transition: width .32s var(--ease), border-radius .32s ease, box-shadow .4s var(--ease);
+}
+.dsn-shell:hover { --glow: 0 0 24px rgb(var(--dsn-accent-rgb) / .16); }
+.dsn-anchor[data-mode="compact"] .dsn-shell { --w: 320px; }
+.dsn-anchor[data-mode="peek"] .dsn-shell { --w: 392px; --r: 24px; }
+.dsn-anchor[data-mode="panel"] .dsn-shell { --w: 640px; --r: 24px; }
+.dsn-anchor[data-mode="compact"] .dsn-shell,
+.dsn-anchor[data-mode="peek"] .dsn-shell { --wash: radial-gradient(ellipse 75% 140% at 10% 50%, rgb(var(--dsn-accent-rgb) / .22), transparent 70%); --glow: 0 0 22px rgb(var(--dsn-accent-rgb) / .14); }
+.dsn-anchor[data-mode="panel"][data-view="media"] .dsn-shell { --wash: radial-gradient(ellipse 70% 60% at 14% 0%, rgb(var(--dsn-accent-rgb) / .16), transparent 70%); }
+.dsn-anchor[data-amoled="true"] .dsn-shell { --wash: none; backdrop-filter: none; border-color: rgba(255,255,255,.1); }
+
+/* Bar: collapsed + media-active */
+.dsn-bar { height: 34px; transition: height .3s var(--ease); }
+.dsn-anchor[data-mode="compact"] .dsn-bar { height: 38px; }
+.bar-idle { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 100%; }
+.dsn-notch-indicator { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 6px rgb(var(--green-rgb) / .7), 0 0 14px rgb(var(--green-rgb) / .4); animation: dsn-pulse 3s ease-in-out infinite; }
+@keyframes dsn-pulse { 0%,100% { opacity: .85; } 50% { opacity: 1; } }
+.dsn-collapsed-time { font-size: .88rem; font-weight: 600; font-variant-numeric: tabular-nums; }
+.bar-media { display: flex; align-items: center; gap: 10px; height: 100%; padding: 0 14px 0 6px; }
+.bar-title { flex: 1; min-width: 0; overflow: hidden; text-align: left; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; font-weight: 600; }
+
+.art-btn { position: relative; flex: none; display: grid; place-items: center; overflow: hidden; border-radius: 50%; background: rgba(255,255,255,.08); color: rgb(var(--dsn-accent-rgb)); }
+.art-btn canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
+.art-btn .ico { font-size: 14px; }
+.art-btn:hover { box-shadow: 0 0 0 2px rgb(var(--dsn-accent-rgb) / .5); }
+.bar-art { width: 28px; height: 28px; }
+.peek-art { width: 46px; height: 46px; border-radius: 13px; }
+.media-art { width: 84px; height: 84px; border-radius: 20px; }
+.art-badge { position: absolute; right: 0; bottom: 0; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 9px 0 18px 0; background: rgba(10,10,12,.9); color: #fff; }
+.art-badge .ico { font-size: 13px; }
+
+.dsn-bars { display: inline-flex; align-items: flex-end; gap: 3px; height: 16px; color: rgb(var(--dsn-accent-rgb)); }
+.dsn-bars i { display: block; width: 3px; height: 35%; border-radius: 2px; background: currentColor; }
+.dsn-bars.is-playing i { animation: dsn-bar .9s ease-in-out infinite; }
+.dsn-bars i:nth-child(2) { animation-delay: .2s; } .dsn-bars i:nth-child(3) { animation-delay: .4s; } .dsn-bars i:nth-child(4) { animation-delay: .1s; }
+@keyframes dsn-bar { 0%,100% { height: 30%; } 50% { height: 100%; } }
+
+/* Peek: mini player on hover */
+.dsn-peek { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 12px 14px 15px; }
+.peek-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; text-align: left; }
+.peek-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .92rem; font-weight: 650; }
+.peek-artist { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: rgba(255,255,255,.55); font-size: .78rem; }
+.peek-controls { display: flex; align-items: center; gap: 6px; }
+.peek-progress { position: absolute; right: 14px; bottom: 6px; left: 14px; height: 2px; border-radius: 2px; background: rgba(255,255,255,.1); }
+.peek-progress i { display: block; width: var(--p, 0%); height: 100%; border-radius: inherit; background: rgb(var(--dsn-accent-rgb)); }
+
+.ctrl { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,.07); font-size: 15px; transition: background .2s ease, transform .2s var(--ease), opacity .2s ease; }
+.ctrl:hover:not(:disabled) { background: rgba(255,255,255,.15); }
+.ctrl:active:not(:disabled) { transform: scale(.94); }
+.ctrl:disabled { opacity: .32; }
+.ctrl[aria-pressed="true"] { color: rgb(var(--dsn-accent-rgb)); background: rgb(var(--dsn-accent-rgb) / .14); }
+.ctrl.play-btn { width: 40px; height: 40px; background: #fff; color: #0a0a0c; font-size: 18px; }
+.ctrl.play-btn:hover:not(:disabled) { background: #fff; transform: scale(1.05); }
+.ctrl.big { width: 62px; height: 62px; font-size: 26px; }
+
+/* Panel: Notchland */
+.dsn-panel { display: flex; flex-direction: column; gap: 14px; width: 100%; padding: 18px 20px 16px; }
+.dsn-expanded-topline, .dsn-view-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 2px 4px 0; }
+.topline-right { display: inline-flex; align-items: center; gap: 10px; }
+.dsn-expanded-clock { font-size: 1.45rem; font-weight: 600; font-variant-numeric: tabular-nums; }
+.dsn-expanded-date, .dsn-view-kicker, .dsn-command-hint { color: rgba(255,255,255,.5); font-size: .76rem; }
+.dsn-view-heading strong { font-size: 1rem; }
+.grip { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; color: rgba(255,255,255,.5); cursor: grab; }
+.grip:hover { background: rgba(255,255,255,.08); color: #fff; }
+.dsn-search-wrap { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 14px; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.03); }
+.dsn-search-wrap:focus-within { border-color: rgb(var(--green-rgb) / .3); box-shadow: 0 0 0 3px rgb(var(--green-rgb) / .08); }
+.dsn-search-input { width: 100%; padding: 12px 0; border: 0; outline: 0; background: transparent; user-select: text; }
+.dsn-search-input::placeholder { color: rgba(255,255,255,.4); }
+.dsn-feedback { padding: 9px 10px; border: 1px solid rgb(var(--green-rgb) / .18); border-radius: 10px; background: rgb(var(--green-rgb) / .06); color: #c1d82f; font-size: .76rem; user-select: text; }
+.dsn-app-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+.dsn-app-card { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 12px; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(255,255,255,.03); text-align: left; transition: background .25s ease, border-color .25s ease, transform .25s ease; }
+.dsn-app-card:hover { transform: translateY(-1px); border-color: rgb(var(--green-rgb) / .25); background: rgb(var(--green-rgb) / .08); }
+.dsn-app-icon { display: grid; flex: none; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: rgb(var(--green-rgb) / .1); color: var(--green); }
+.dsn-app-card > span:last-child { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.dsn-app-card small { overflow: hidden; color: rgba(255,255,255,.5); font-size: .68rem; text-overflow: ellipsis; white-space: nowrap; }
+.dsn-actions { display: flex; gap: 10px; padding-top: 2px; }
+.dsn-action { flex: 1; min-height: 38px; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(255,255,255,.03); transition: background .25s var(--ease), border-color .25s ease, transform .25s var(--ease); }
+.dsn-action:hover, .dsn-action.is-active { border-color: rgb(var(--green-rgb) / .25); background: rgb(var(--green-rgb) / .08); }
+.dsn-action[data-view="media"]:hover, .dsn-action[data-view="media"].is-active { border-color: rgb(var(--dsn-accent-rgb) / .4); background: rgb(var(--dsn-accent-rgb) / .12); color: rgb(var(--dsn-accent-rgb)); }
+.dsn-action:active { transform: scale(.98); }
+
+/* Full media view */
+.dsn-media { display: flex; flex-direction: column; gap: 12px; }
+.media-head { display: flex; align-items: center; gap: 16px; }
+.media-meta { flex: 1; min-width: 0; }
+.media-label { color: rgba(255,255,255,.5); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }
+.media-title { overflow: hidden; margin-top: 2px; text-overflow: ellipsis; white-space: nowrap; font-size: 1.45rem; font-weight: 700; line-height: 1.15; }
+.media-artist { overflow: hidden; margin-top: 3px; color: rgba(255,255,255,.62); font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }
+.media-source { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; color: rgba(255,255,255,.42); font-size: .72rem; }
+.media-source:hover { color: rgb(var(--dsn-accent-rgb)); }
+.seek { display: flex; flex-direction: column; gap: 2px; }
+.times { display: flex; justify-content: space-between; color: rgba(255,255,255,.5); font-size: .74rem; font-variant-numeric: tabular-nums; }
+input[type="range"] { --p: 0%; appearance: none; width: 100%; height: 18px; margin: 0; background: transparent; cursor: pointer; }
+input[type="range"]::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, rgb(var(--dsn-accent-rgb)) var(--p), rgba(255,255,255,.18) var(--p)); }
+input[type="range"]::-webkit-slider-thumb { appearance: none; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.5); }
+input[type="range"]:disabled { opacity: .35; cursor: default; }
+.controls { display: flex; align-items: center; justify-content: center; gap: 16px; }
+.vol { display: flex; align-items: center; gap: 6px; }
+.vol input[type="range"] { width: 72px; }
+.extras { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }

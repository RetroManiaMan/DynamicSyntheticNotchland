diff --git a/tests/e2e/server.mjs b/tests/e2e/server.mjs
new file mode 100644
index 0000000..1c7bca8
--- /dev/null
+++ b/tests/e2e/server.mjs
@@ -0,0 +1,53 @@
+import { createServer } from 'node:http'
+import { createReadStream, existsSync, statSync } from 'node:fs'
+import { extname, join, normalize } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = join(fileURLToPath(new URL('.', import.meta.url)), 'fixtures')
+const types = { '.html': 'text/html; charset=utf-8', '.png': 'image/png', '.mp3': 'audio/mpeg', '.mp4': 'video/mp4', '.json': 'application/json' }
+export const stats = { lyricsRequests: 0, lyricsUrls: [] }
+const LONG = Array.from({ length: 24 }, (_, i) => `[00:${String(i + 1).padStart(2, '0')}.00]Long line ${i + 1}`).join('\n')
+const LRC = '[00:00.50]Line one\n[00:03.00]Line two\n[00:06.00]Line three\n[00:09.00]Line four'
+
+function serveFile(req, res, file, extra = {}) {
+  const size = statSync(file).size
+  const type = types[extname(file)] || 'application/octet-stream'
+  const range = /bytes=(\d*)-(\d*)/.exec(req.headers.range || '')
+  if (range) { // media seeking needs Range support
+    const start = range[1] ? Number(range[1]) : 0, end = range[2] ? Number(range[2]) : size - 1
+    res.writeHead(206, { 'Content-Type': type, 'Content-Range': `bytes ${start}-${end}/${size}`, 'Accept-Ranges': 'bytes', 'Content-Length': end - start + 1, ...extra })
+    createReadStream(file, { start, end }).pipe(res)
+  } else {
+    res.writeHead(200, { 'Content-Type': type, 'Content-Length': size, 'Accept-Ranges': 'bytes', ...extra })
+    createReadStream(file).pipe(res)
+  }
+}
+
+function handler(withApi) {
+  return (req, res) => {
+    const url = new URL(req.url, 'http://x')
+    if (withApi && url.pathname.startsWith('/lrclib/')) {
+      stats.lyricsRequests++; stats.lyricsUrls.push(url.pathname + url.search)
+      const longTrack = url.searchParams.get('track_name') === 'Long Track'
+      if (longTrack && url.pathname === '/lrclib/get') { res.writeHead(200, { 'Content-Type': 'application/json' }); return res.end(JSON.stringify({ id: 2, trackName: 'Long Track', artistName: 'Test Artist', duration: 90, syncedLyrics: LONG, plainLyrics: 'x' })) }
+      const known = url.searchParams.get('track_name') === 'Test Track'
+      if (url.pathname === '/lrclib/get') {
+        if (!known) { res.writeHead(404, { 'Content-Type': 'application/json' }); return res.end('{"statusCode":404}') }
+        res.writeHead(200, { 'Content-Type': 'application/json' })
+        return res.end(JSON.stringify({ id: 1, trackName: 'Test Track', artistName: 'Test Artist', duration: 90, instrumental: false, plainLyrics: 'Line one\nLine two', syncedLyrics: LRC }))
+      }
+      res.writeHead(200, { 'Content-Type': 'application/json' }); return res.end('[]')
+    }
+    const file = normalize(join(root, url.pathname === '/' ? 'plain.html' : url.pathname))
+    if (!file.startsWith(root) || !existsSync(file) || !statSync(file).isFile()) { res.writeHead(404); return res.end('not found') }
+    const csp = url.pathname === '/csp-media.html'
+      ? { 'Content-Security-Policy': "default-src 'none'; script-src 'unsafe-inline'; style-src 'none'; img-src 'none'; media-src 'self'; require-trusted-types-for 'script'" } : {}
+    serveFile(req, res, file, csp)
+  }
+}
+
+export function startServers() {
+  // 8001: the "site" under test + lyrics stub. 8002: a second origin with no CORS headers (cross-origin artwork).
+  const servers = [createServer(handler(true)).listen(8001, '127.0.0.1'), createServer(handler(false)).listen(8002, '127.0.0.1')]
+  return () => servers.forEach((server) => server.close())
+}

@@ -0,0 +1,39 @@
+import { DSN_GREEN, parseHex, toHex, type Rgb } from '../shared/color.ts'
+
+const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2)
+
+/**
+ * Drives --dsn-accent / --dsn-accent-rgb from JS. CSS can't animate a custom property inside a shadow root
+ * (@property is ignored there), so the fade is interpolated here. Respects reduced motion.
+ */
+export function createAccentAnimator(target: HTMLElement, reducedMotion: () => boolean) {
+  let current: Rgb = parseHex(DSN_GREEN)!
+  let goal = DSN_GREEN
+  let frame = 0
+  const paint = (rgb: Rgb) => {
+    target.style.setProperty('--dsn-accent', toHex(rgb.map(Math.round) as Rgb))
+    target.style.setProperty('--dsn-accent-rgb', rgb.map(Math.round).join(' '))
+  }
+  paint(current)
+  return {
+    get goal() { return goal },
+    to(hex: string, duration = 520): void {
+      if (hex === goal) return
+      goal = hex
+      const next = parseHex(hex)
+      cancelAnimationFrame(frame)
+      if (!next) return
+      if (reducedMotion() || duration <= 0) { current = next; paint(next); return }
+      const from = current, start = performance.now()
+      const step = (now: number) => {
+        const t = Math.min(1, (now - start) / duration)
+        const k = ease(t)
+        current = [0, 1, 2].map((i) => from[i]! + (next[i]! - from[i]!) * k) as Rgb
+        paint(current)
+        if (t < 1) frame = requestAnimationFrame(step)
+      }
+      frame = requestAnimationFrame(step)
+    },
+    stop: () => cancelAnimationFrame(frame),
+  }
+}

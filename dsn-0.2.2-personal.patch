--- /dev/null
+++ b/src/shared/protocol.ts
@@ -0,0 +1,80 @@
+/** Messages between content scripts, the service worker and extension pages. */
+
+export const HUB_KEY = 'dsn-hub-v1' // chrome.storage.session
+
+export type MediaAction = 'play' | 'pause' | 'toggle' | 'seek' | 'previous' | 'next' | 'mute' | 'volume' | 'repeat'
+export const MEDIA_ACTIONS: readonly MediaAction[] = ['play', 'pause', 'toggle', 'seek', 'previous', 'next', 'mute', 'volume', 'repeat']
+
+/** What the source page can genuinely do. UI only enables controls that are true here. */
+export interface Capabilities {
+  play: boolean
+  seek: boolean
+  previous: boolean
+  next: boolean
+  volume: boolean
+  repeat: boolean
+}
+
+/** Reported by the tab that owns the media. Position is a sample; consumers extrapolate. */
+export interface SourceSnapshot {
+  title: string
+  artist: string
+  album: string
+  artworkUrl: string | null
+  playing: boolean
+  position: number
+  at: number
+  duration: number | null
+  rate: number
+  muted: boolean
+  volume: number
+  repeat: boolean
+  caps: Capabilities
+  host: string
+  pageUrl: string
+}
+
+export interface ArtResult {
+  /** Normalised accent derived from the artwork, or null if it could not be extracted. */
+  accent: string | null
+  /** Small base64 image (WebP/JPEG) fetched once by the service worker. */
+  thumb: string | null
+}
+
+export interface SessionView extends SourceSnapshot {
+  key: string
+  tabId: number
+  windowId: number
+  frameId: number
+  /** Last time play state or track changed; drives which session is "current". */
+  updatedAt: number
+  /** Last time the source reported anything (heartbeat while playing). */
+  lastSeen: number
+  /** undefined = not resolved yet, null = resolved but unavailable. */
+  art?: ArtResult | null
+}
+
+/** What the service worker mirrors into chrome.storage.session; every tab's notch watches it. */
+export interface HubStored {
+  sessions: SessionView[]
+  rev: number
+}
+
+export type ToWorker =
+  | { t: 'snapshot'; snap: SourceSnapshot }
+  | { t: 'gone' }
+  | { t: 'hub:get' }
+  | { t: 'control'; key: string; action: MediaAction; value?: number | boolean }
+  | { t: 'focus'; key: string }
+  | { t: 'lyrics'; title: string; artist: string; album: string; duration: number | null }
+  | { t: 'open-settings' }
+  | { t: 'focus-allow'; host: string }
+  | { t: 'browser-action'; action: { type: 'open'; url: string } | { type: 'newtab' } }
+
+export type ToSource = { t: 'command'; action: MediaAction; value?: number | boolean }
+
+export interface LyricsResult {
+  status: 'ok' | 'not-found' | 'disabled' | 'error'
+  synced: { t: number; text: string }[] | null
+  plain: string | null
+}

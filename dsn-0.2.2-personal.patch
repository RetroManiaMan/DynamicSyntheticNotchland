new file mode 100644
index 0000000..8cac405
--- /dev/null
+++ b/src/shared/library.ts
@@ -0,0 +1,68 @@
+export const LIBRARY_KEY = 'dsn-library-v1'
+const MAX_ITEMS = 500
+
+export interface LibraryItem {
+  id: string
+  title: string
+  artist: string
+  album: string
+  host: string
+  /** Page the media was playing on, so it can be reopened. http(s) only. */
+  pageUrl: string
+  savedAt: number
+  favorite: boolean
+  saved: boolean
+}
+
+export type TrackRef = Pick<LibraryItem, 'title' | 'artist' | 'album' | 'host' | 'pageUrl'>
+
+export function trackId(track: Pick<TrackRef, 'title' | 'artist'>): string {
+  return `${track.title.trim().toLowerCase()}\u0001${track.artist.trim().toLowerCase()}`
+}
+
+export async function getLibrary(): Promise<LibraryItem[]> {
+  try {
+    const stored = await chrome.storage.local.get(LIBRARY_KEY)
+    const raw = stored[LIBRARY_KEY]
+    return Array.isArray(raw) ? raw.filter((item) => item && typeof item.id === 'string').slice(0, MAX_ITEMS) : []
+  } catch {
+    return []
+  }
+}
+
+async function write(items: LibraryItem[]) {
+  await chrome.storage.local.set({ [LIBRARY_KEY]: items.filter((item) => item.favorite || item.saved).slice(0, MAX_ITEMS) })
+}
+
+export async function toggleFlag(track: TrackRef, flag: 'favorite' | 'saved'): Promise<LibraryItem[]> {
+  const items = await getLibrary()
+  const id = trackId(track)
+  const existing = items.find((item) => item.id === id)
+  if (existing) existing[flag] = !existing[flag]
+  else {
+    const safeUrl = /^https?:\/\//i.test(track.pageUrl) ? track.pageUrl.slice(0, 2048) : ''
+    items.unshift({
+      id, title: track.title.slice(0, 200), artist: track.artist.slice(0, 200), album: track.album.slice(0, 200),
+      host: track.host.slice(0, 120), pageUrl: safeUrl, savedAt: Date.now(), favorite: flag === 'favorite', saved: flag === 'saved',
+    })
+  }
+  await write(items)
+  return getLibrary()
+}
+
+export async function removeFromLibrary(id: string): Promise<LibraryItem[]> {
+  await write((await getLibrary()).filter((item) => item.id !== id))
+  return getLibrary()
+}
+
+export async function clearLibrary(): Promise<void> {
+  await chrome.storage.local.remove(LIBRARY_KEY)
+}
+
+export function watchLibrary(callback: (items: LibraryItem[]) => void): () => void {
+  const listener = (changes: Record<string, chrome.storage.StorageChange>, area: string) => {
+    if (area === 'local' && changes[LIBRARY_KEY]) void getLibrary().then(callback)
+  }
+  chrome.storage.onChanged.addListener(listener)
+  return () => chrome.storage.onChanged.removeListener(listener)
+}

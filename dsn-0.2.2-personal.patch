+const sample = '[ar:Someone]\n[00:12.00]First line\n[00:17.20]Second line\n[01:02.5]Third\n[00:05.00][00:30.00]Chorus\n[00:40.00]\n'
+test('parses, sorts, handles repeats and metadata', () => {
+  const lines = parseLrc(sample)
+  assert.deepEqual(lines.map((l) => l.text), ['Chorus', 'First line', 'Second line', 'Chorus', '', 'Third'])
+  assert.equal(lines[0]!.t, 5); assert.equal(lines[2]!.t, 17.2); assert.equal(lines.at(-1)!.t, 62.5)
+})
+test('finds the active line', () => {
+  const lines = parseLrc(sample)
+  assert.equal(lineIndexAt(lines, 1), -1)
+  assert.equal(lineIndexAt(lines, 5), 0)
+  assert.equal(lineIndexAt(lines, 13), 1)
+  assert.equal(lineIndexAt(lines, 999), lines.length - 1)
+})
+test('empty and garbage input is safe', () => { assert.deepEqual(parseLrc(''), []); assert.deepEqual(parseLrc('no stamps here'), []) })
+test('position projection', () => {
+  const s = { position: 10, at: 1000, rate: 1, playing: true, duration: 100 }
+  assert.equal(projectPosition(s, 3000), 12)
+  assert.equal(projectPosition({ ...s, playing: false }, 9000), 10)
+  assert.equal(projectPosition({ ...s, rate: 2 }, 3000), 14)
+  assert.equal(projectPosition(s, 999_999), 100)
+  assert.equal(projectPosition({ ...s, duration: null }, 3000), 12)
+})
+test('formats time', () => { assert.equal(formatTime(65), '1:05'); assert.equal(formatTime(3725), '1:02:05'); assert.equal(formatTime(NaN), '0:00') })

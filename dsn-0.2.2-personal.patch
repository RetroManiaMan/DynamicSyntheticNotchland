--- /dev/null
+++ b/src/content/main-world.ts
@@ -0,0 +1,33 @@
+/**
+ * Runs in the page's own JS world at document_start (manifest: "world": "MAIN").
+ * Its only job: remember the Media Session handlers the page registers (previous/next/etc.)
+ * so DSN can invoke them on request. It does nothing else and talks only through two DOM events
+ * carrying plain strings. Without this, previous/next cannot be controlled from an extension.
+ */
+;(() => {
+  try {
+    const proto = typeof MediaSession === 'undefined' ? null : MediaSession.prototype
+    if (!proto || (proto as any).__dsnPatched) return
+    const handlers: Record<string, ((details: object) => void) | null> = Object.create(null)
+    const original = proto.setActionHandler
+    const announce = () => {
+      const actions = Object.keys(handlers).filter((name) => typeof handlers[name] === 'function')
+      window.dispatchEvent(new CustomEvent('dsn:actions', { detail: JSON.stringify(actions) }))
+    }
+    proto.setActionHandler = function (this: MediaSession, action: MediaSessionAction, handler: MediaSessionActionHandler | null) {
+      handlers[action] = handler as ((details: object) => void) | null
+      try { announce() } catch { /* never break the page */ }
+      return original.call(this, action, handler)
+    }
+    Object.defineProperty(proto, '__dsnPatched', { value: true })
+
+    window.addEventListener('dsn:query', announce)
+    window.addEventListener('dsn:invoke', (event) => {
+      try {
+        const { action, seekTime } = JSON.parse(String((event as CustomEvent).detail)) as { action: string; seekTime?: number }
+        const handler = handlers[action]
+        if (typeof handler === 'function') handler(typeof seekTime === 'number' ? { action, seekTime } : { action })
+      } catch { /* ignore malformed requests */ }
+    })
+  } catch { /* the page must never be affected */ }
+})()

+
+/**
+ * Entry for the isolated-world content script (all frames).
+ * Every frame can report media; only the top frame of an HTML page gets the notch.
+ */
+function boot(): void {
+  startSource()
+  if (window !== window.top) return
+  if (!/html/i.test(document.contentType) || !document.documentElement) return
+  mountShell()
+}
+
+boot()

diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..1f1fa6d
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,53 @@
+// Builds the extension into dist/ (or dist-test/ with --test).
+//  1. extension pages (Settings, Blocked) with Vite + React
+//  2. content script, MAIN-world bridge and service worker as single-file IIFE bundles
+//     (content scripts and MV3 workers can't import shared chunks, which is why these are separate passes)
+//  3. manifest, version-checked against package.json
+import { build } from 'vite'
+import react from '@vitejs/plugin-react'
+import { cpSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+
+const test = process.argv.includes('--test')
+const outDir = resolve(test ? 'dist-test' : 'dist')
+const pkg = JSON.parse(readFileSync('package.json', 'utf8'))
+const manifest = JSON.parse(readFileSync('manifest.json', 'utf8'))
+if (manifest.version !== pkg.version) throw new Error(`manifest.json (${manifest.version}) and package.json (${pkg.version}) versions differ`)
+
+const define = {
+  __DSN_TEST__: JSON.stringify(test),
+  __LRCLIB_BASE__: JSON.stringify(process.env.DSN_LRCLIB_BASE || (test ? 'http://localhost:8001/lrclib' : 'https://lrclib.net/api')),
+}
+const common = { configFile: false, logLevel: 'warn', define }
+
+rmSync(outDir, { recursive: true, force: true })
+
+await build({
+  ...common,
+  plugins: [react()],
+  base: './',
+  publicDir: 'public',
+  build: { outDir, emptyOutDir: true, target: 'chrome120', minify: !test, rollupOptions: { input: { settings: resolve('settings.html') } } },
+})
+
+// The blocked page is opened by a network redirect, so it must be web-accessible. Building it on its own keeps
+// the exposed surface to blocked.html + blocked-assets/* (not the Settings bundle).
+await build({
+  ...common,
+  plugins: [react()],
+  base: './',
+  publicDir: false,
+  build: { outDir, emptyOutDir: false, assetsDir: 'blocked-assets', target: 'chrome120', minify: !test, rollupOptions: { input: { blocked: resolve('blocked.html') } } },
+})
+
+for (const [entry, file] of [['src/content/index.ts', 'content.js'], ['src/content/main-world.ts', 'content-main.js'], ['src/background/index.ts', 'background.js']]) {
+  await build({
+    ...common,
+    publicDir: false,
+    build: { outDir, emptyOutDir: false, target: 'chrome120', minify: !test, lib: { entry: resolve(entry), name: 'DSN', formats: ['iife'], fileName: () => file } },
+  })
+}
+
+writeFileSync(resolve(outDir, 'manifest.json'), JSON.stringify(manifest, null, 2))
+for (const name of ['LICENSE', 'LICENSE-ASSETS']) cpSync(name, resolve(outDir, name), { force: true })
+console.log(`Built DSN ${pkg.version}${test ? ' (test build)' : ''} -> ${outDir}`)

+type Attr = string | number | boolean | null | undefined | ((event: any) => void)
+type Child = Node | string | null | undefined | false
+
+/** Tiny element builder. Builds nodes (never parses HTML) so it is safe on Trusted Types pages. */
+export function h<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, Attr> = {}, ...kids: Child[]): HTMLElementTagNameMap[K] {
+  const el = document.createElement(tag)
+  for (const [key, value] of Object.entries(attrs)) {
+    if (value == null || value === false) continue
+    if (key.startsWith('on') && typeof value === 'function') el.addEventListener(key.slice(2), value as EventListener)
+    else if (key === 'class') el.className = String(value)
+    else el.setAttribute(key, value === true ? '' : String(value))
+  }
+  for (const kid of kids) if (kid != null && kid !== false) el.append(kid)
+  return el
+}

+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { sanitizeSettings, DEFAULT_SETTINGS } from '../../src/shared/settings.ts'
+
+test('garbage becomes defaults', () => {
+  for (const raw of [null, undefined, 5, 'x', [], {}]) assert.deepEqual(sanitizeSettings(raw), DEFAULT_SETTINGS)
+})
+test('legacy v0.2.2 settings keep their values and gain new defaults', () => {
+  const s = sanitizeSettings({ dynamicMediaAccent: false, feedbackPromptsEnabled: false })
+  assert.equal(s.dynamicMediaAccent, false); assert.equal(s.feedbackPromptsEnabled, false)
+  assert.equal(s.amoled, false); assert.equal(s.placement, 'top'); assert.equal(s.lyricsEnabled, false)
+})
+test('validates placement, position and focus sites', () => {
+  const s = sanitizeSettings({ placement: 'diagonal', freePosition: { x: 9, y: -3 }, focus: { enabled: true, sites: ['https://www.Reddit.com/r/x', 'reddit.com', 'javascript:1', 7, 'x.com'] } })
+  assert.equal(s.placement, 'top'); assert.deepEqual(s.freePosition, { x: 1, y: 0 })
+  assert.deepEqual(s.focus, { enabled: true, strict: false, sites: ['reddit.com', 'x.com'] })
+})
+test('wrong types are not coerced', () => assert.equal(sanitizeSettings({ amoled: 'yes', lyricsEnabled: 1 }).amoled, false))
+
+import { pickCurrent } from '../../src/shared/select.ts'
+const base = { title: 't', artist: 'a', album: '', artworkUrl: null, playing: false, position: 0, at: 0, duration: null, rate: 1, muted: false, volume: 1, repeat: false, caps: { play: true, seek: true, previous: false, next: false, volume: true, repeat: true }, host: 'h', pageUrl: '', key: 'k', tabId: 1, windowId: 1, frameId: 0, updatedAt: 0, lastSeen: 0 }
+test('current session: newest live playback wins; paused sessions persist; stale "playing" counts as paused', () => {
+  const now = 1_000_000
+  const paused = { ...base, key: 'p', updatedAt: now - 5000, lastSeen: now - 5000 }
+  const playing = { ...base, key: 'l', playing: true, updatedAt: now - 9000, lastSeen: now - 1000 }
+  const stale = { ...base, key: 's', playing: true, updatedAt: now - 1000, lastSeen: now - 200_000 }
+  assert.equal(pickCurrent([paused, playing], now)?.key, 'l')
+  assert.equal(pickCurrent([paused], now)?.key, 'p')
+  assert.equal(pickCurrent([paused, stale], now)?.key, 's') // both effectively paused: most recently updated wins
+  assert.equal(pickCurrent([stale, playing], now)?.key, 'l')
+  assert.equal(pickCurrent([], now), null)
+})

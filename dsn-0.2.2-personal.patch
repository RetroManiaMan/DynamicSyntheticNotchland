@@ -0,0 +1,33 @@
+/** Host helpers for Focus Mode. Pure, no browser APIs. */
+
+const LABEL = /^(?!-)[a-z0-9-]{1,63}(?<!-)$/
+
+/** Turns user input ("https://www.Example.com/path", "example.com") into a bare hostname, or null if unusable. */
+export function normalizeHost(input: string): string | null {
+  const raw = String(input ?? '').trim().toLowerCase()
+  if (!raw || raw.length > 300) return null
+  let host: string
+  try {
+    const url = new URL(raw.includes('://') ? raw : `https://${raw}`)
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') return null
+    host = url.hostname
+  } catch {
+    return null
+  }
+  host = host.replace(/^www\./, '').replace(/\.$/, '')
+  if (!host || host.length > 253) return null
+  if (/^\d+(\.\d+){0,3}$/.test(host)) return null // bare numbers / IPv4 are not sites a person means to block
+  const labels = host.split('.')
+  if (!labels.every((label) => LABEL.test(label))) return null
+  if (labels.length < 2 && host !== 'localhost') return null
+  return host
+}
+
+/** True when `host` is `blocked` or one of its subdomains. */
+export function hostMatches(host: string, blocked: string): boolean {
+  return host === blocked || host.endsWith(`.${blocked}`)
+}
+
+export function isBlockedHost(host: string, sites: readonly string[]): boolean {
+  return sites.some((site) => hostMatches(host, site))
+}

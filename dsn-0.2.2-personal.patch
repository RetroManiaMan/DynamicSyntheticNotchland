diff --git a/tests/e2e/run.mjs b/tests/e2e/run.mjs
new file mode 100644
index 0000000..8d9c833
--- /dev/null
+++ b/tests/e2e/run.mjs
@@ -0,0 +1,363 @@
+// End-to-end tests: loads the real built extension in Chromium and drives it.
+//   npm run build:test && node tests/e2e/run.mjs        (set DSN_CHROMIUM to a Chromium/Chrome-for-Testing binary)
+import assert from 'node:assert/strict'
+import { existsSync, mkdirSync, mkdtempSync, readdirSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { chromium } from 'playwright-core'
+import { startServers, stats } from './server.mjs'
+
+const ROOT = resolve(new URL('../..', import.meta.url).pathname)
+const SHOTS = join(ROOT, 'tests/e2e/shots'); mkdirSync(SHOTS, { recursive: true })
+const BASE = 'http://localhost:8001'
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+function findChromium() {
+  if (process.env.DSN_CHROMIUM) return process.env.DSN_CHROMIUM
+  const dir = '/opt/chromium'
+  const hit = existsSync(dir) && readdirSync(dir).find((d) => d.startsWith('ungoogled-chromium-') && !d.endsWith('.xz'))
+  if (hit) return join(dir, hit, 'chrome')
+  throw new Error('Set DSN_CHROMIUM to a Chromium binary that supports --load-extension')
+}
+
+async function launch(extDir, { reducedMotion } = {}) {
+  const ctx = await chromium.launchPersistentContext(mkdtempSync(join(tmpdir(), 'dsn-e2e-')), {
+    executablePath: findChromium(), headless: true, viewport: { width: 1280, height: 800 }, reducedMotion,
+    args: [`--disable-extensions-except=${extDir}`, `--load-extension=${extDir}`, '--autoplay-policy=no-user-gesture-required', '--no-sandbox', '--disable-gpu', '--force-color-profile=srgb'],
+  })
+  const worker = ctx.serviceWorkers()[0] ?? (await ctx.waitForEvent('serviceworker', { timeout: 10_000 }))
+  const id = new URL(worker.url()).host
+  let extPage
+  const api = {
+    ctx, id,
+    async ext() { return (extPage ??= await (async () => { const p = await ctx.newPage(); await p.goto(`chrome-extension://${id}/settings.html`); return p })()) },
+    async settings() { const p = await api.ext(); return p.evaluate(async () => (await chrome.storage.local.get('dsn-settings-v1'))['dsn-settings-v1'] ?? {}) },
+    async setSettings(patch) {
+      const p = await api.ext()
+      await p.evaluate(async (patch) => {
+        const k = 'dsn-settings-v1', cur = (await chrome.storage.local.get(k))[k] ?? {}
+        await chrome.storage.local.set({ [k]: { ...cur, ...patch, focus: { ...(cur.focus ?? {}), ...(patch.focus ?? {}) } } })
+      }, patch)
+      await sleep(250)
+    },
+    async killWorker(page) { const cdp = await ctx.newCDPSession(page); await cdp.send('ServiceWorker.enable'); await cdp.send('ServiceWorker.stopAllWorkers'); await cdp.detach().catch(() => {}) },
+    async open(url) { const p = await ctx.newPage(); await p.goto(url); await p.bringToFront(); return p },
+  }
+  return api
+}
+
+const probe = () => {
+  const host = document.getElementById('dsn-root')
+  const sr = host?.shadowRoot
+  if (!host) return { mounted: false }
+  if (!sr) return { mounted: true, closed: true }
+  const anchor = sr.querySelector('.dsn-anchor'), shell = sr.querySelector('.dsn-shell'), r = shell.getBoundingClientRect(), q = (s) => sr.querySelector(s)
+  const visible = (s) => { const el = q(s); return !!el && !el.hidden && !el.closest('[hidden]') }
+  return {
+    mounted: true, mode: anchor.dataset.mode, view: anchor.dataset.view, placement: anchor.dataset.placement,
+    accent: getComputedStyle(anchor).getPropertyValue('--dsn-accent').trim(), surface: getComputedStyle(anchor).getPropertyValue('--surface-a').trim(),
+    rect: { x: r.x, y: r.y, w: r.width, h: r.height, right: r.right, bottom: r.bottom },
+    barTitle: q('.bar-title')?.textContent ?? '', searchVisible: visible('.dsn-search-input'), mediaVisible: visible('.dsn-media'),
+    playing: !!q('.bar-media .dsn-bars.is-playing'), vw: innerWidth, vh: innerHeight,
+    artPainted: [...sr.querySelectorAll('.bar-art canvas, .peek-art canvas, .media-art canvas')].some((c) => { if (c.hidden) return false; const d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data; for (let i = 3; i < d.length; i += 4) if (d[i] > 0) return true; return false }),
+  }
+}
+const state = (page) => page.evaluate(probe)
+const waitState = async (page, pred, what, ms = 8000) => {
+  const end = Date.now() + ms; let s
+  while (Date.now() < end) { s = await state(page); if (pred(s)) return s; await sleep(150) }
+  throw new Error(`timed out waiting for ${what}. last: ${JSON.stringify(s)}`)
+}
+const hueOf = (hex) => { const n = parseInt(hex.slice(1), 16), r = (n >> 16) / 255, g = ((n >> 8) & 255) / 255, b = (n & 255) / 255, mx = Math.max(r, g, b), d = mx - Math.min(r, g, b); if (!d) return 0; const h = mx === r ? ((g - b) / d + 6) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; return h * 60 }
+const sampleAccent = (page, ms) => page.evaluate((ms) => new Promise((res) => {
+  const a = document.getElementById('dsn-root').shadowRoot.querySelector('.dsn-anchor'), seen = [], t0 = performance.now()
+  ;(function tick() { const v = getComputedStyle(a).getPropertyValue('--dsn-accent').trim(); if (seen[seen.length - 1] !== v) seen.push(v); if (performance.now() - t0 < ms) requestAnimationFrame(tick); else res(seen) })()
+}), ms)
+
+const results = []
+async function step(name, fn) {
+  let timer
+  const limit = new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('step timed out after 75s')), 75_000) })
+  try { await Promise.race([fn(), limit]); clearTimeout(timer); results.push({ name, ok: true }); console.log(`  ok    ${name}`) }
+  catch (e) { clearTimeout(timer); results.push({ name, ok: false, err: e.message }); console.log(`  FAIL  ${name}\n        ${String(e.message).split('\n').slice(0, 3).join('\n        ')}`) }
+}
+const group = (title) => console.log(`\n${title}`)
+
+async function main() {
+  const prodMode = process.argv.includes('--prod')
+  const extDir = join(ROOT, prodMode ? 'dist' : 'dist-test')
+  if (!existsSync(join(extDir, 'manifest.json'))) throw new Error(`${extDir} not built`)
+  const stop = startServers()
+  try {
+    if (prodMode) await prod(extDir); else await all(extDir)
+  } finally { stop() }
+  const failed = results.filter((r) => !r.ok)
+  console.log(`\n${results.length - failed.length}/${results.length} passed${failed.length ? `, ${failed.length} failed` : ''}`)
+  process.exit(failed.length ? 1 : 0)
+}
+
+async function prod(extDir) {
+  group('Production build smoke')
+  const x = await launch(extDir)
+  const page = await x.open(`${BASE}/plain.html`); await sleep(1200)
+  await step('mounts with a CLOSED shadow root (page scripts cannot read what you type)', async () => { const s = await state(page); assert.equal(s.mounted, true); assert.equal(s.closed, true) })
+  await step('no icons/permissions regressions: manifest has icons and no tabs/windows permission', async () => {
+    const m = await (await x.ext()).evaluate(() => chrome.runtime.getManifest())
+    assert.ok(m.icons['128'] && m.action.default_icon['16'])
+    assert.ok(!m.permissions.includes('tabs') && !m.permissions.includes('windows'), JSON.stringify(m.permissions))
+  })
+  await x.ctx.close()
+}
+
+async function all(extDir) {
+  // ---------------------------------------------------------------- shell
+  group('Shell: states, placement, AMOLED, commands')
+  let x = await launch(extDir)
+  let page = await x.open(`${BASE}/plain.html`); await sleep(1000)
+  await step('collapsed notch is shorter than v0.2.1 (was 42px) and 200px wide', async () => { const s = await state(page); assert.equal(s.mode, 'collapsed'); assert.ok(s.rect.h <= 36.5, `h=${s.rect.h}`); assert.equal(Math.round(s.rect.w), 200) })
+  await step('hover opens the panel (no media) and Escape closes it', async () => {
+    await page.locator('.dsn-shell').hover(); await waitState(page, (s) => s.mode === 'panel', 'panel on hover')
+    await page.keyboard.press('Escape'); await page.mouse.move(600, 500); await waitState(page, (s) => s.mode === 'collapsed', 'collapse')
+  })
+  for (const [placement, check] of [['bottom', (s) => Math.abs(s.vh - s.rect.bottom - 10) <= 2], ['left', (s) => Math.abs(s.rect.x - 10) <= 2], ['right', (s) => Math.abs(s.vw - s.rect.right - 10) <= 2], ['top', (s) => Math.abs(s.rect.y - 10) <= 2]]) {
+    await step(`placement "${placement}" docks to the right edge`, async () => { await x.setSettings({ placement }); await waitState(page, (s) => s.placement === placement && check(s), placement) })
+  }
+  await step('free placement: drag moves it, does not open it, and the position persists across reloads', async () => {
+    await x.setSettings({ placement: 'free', freePosition: { x: 0.5, y: 0.04 } }); await sleep(300)
+    const before = await state(page)
+    await page.mouse.move(before.rect.x + 40, before.rect.y + 17); await page.mouse.down(); await page.mouse.move(before.rect.x + 340, before.rect.y + 237, { steps: 10 }); await page.mouse.up(); await sleep(600)
+    await page.mouse.move(40, 760); await waitState(page, (s) => s.mode === 'collapsed', 'collapsed after leaving (a drag must not pin the panel open)')
+    const after = await state(page)
+    const cx = (r) => r.x + r.w / 2
+    assert.ok(cx(after.rect) - cx(before.rect) > 250 && after.rect.y - before.rect.y > 180, JSON.stringify([before.rect, after.rect]))
+    const saved = (await x.settings()).freePosition; assert.ok(saved.x > 0.6 && saved.y > 0.2, JSON.stringify(saved))
+    await page.mouse.move(40, 760); await page.reload(); await sleep(1200); const reloaded = await state(page)
+    assert.ok(Math.abs(cx(reloaded.rect) - cx(after.rect)) <= 3 && Math.abs(reloaded.rect.y - after.rect.y) <= 3, `position not restored: ${JSON.stringify([after.rect, reloaded.rect])}`)
+  })
+  await step('free placement: keyboard grip moves it with arrow keys', async () => {
+    await page.locator('.dsn-shell').hover(); await waitState(page, (s) => s.mode === 'panel', 'panel')
+    const before = (await x.settings()).freePosition
+    await page.locator('.grip').focus(); await page.keyboard.press('ArrowRight'); await page.keyboard.press('ArrowRight'); await sleep(500)
+    const after = (await x.settings()).freePosition; assert.ok(after.x > before.x, `${before.x} -> ${after.x}`)
+    await page.keyboard.press('Escape')
+  })
+  await step('AMOLED turns the surface pure black', async () => { await x.setSettings({ placement: 'top', amoled: true }); const s = await waitState(page, (s) => s.surface === '#000', 'amoled'); assert.equal(s.surface, '#000'); await x.setSettings({ amoled: false }) })
+  await step('/block adds the current site to Focus Mode; /unblock removes it', async () => {
+    const p = await x.open('http://shell-test.localhost:8001/plain.html'); await sleep(800)
+    await p.locator('.dsn-shell').hover(); await p.locator('.dsn-search-input').fill('/block'); await p.keyboard.press('Enter'); await sleep(700)
+    let f = (await x.settings()).focus; assert.ok(f.enabled && f.sites.includes('shell-test.localhost'), JSON.stringify(f))
+    await p.locator('.dsn-search-input').fill('/unblock shell-test.localhost'); await p.keyboard.press('Enter'); await sleep(700)
+    f = (await x.settings()).focus; assert.ok(!f.sites.includes('shell-test.localhost'), JSON.stringify(f)); await p.close()
+  })
+  await x.ctx.close()
+
+  // ---------------------------------------------------------------- media
+  group('Media: detection, accent, hover, controls, restart')
+  x = await launch(extDir); await x.ext() // open the extension page first so it never steals focus later
+  const vid = await x.open(`${BASE}/plain-video.html`); await sleep(500)
+  await step('a muted background video never triggers the media notch (loaded, then playing)', async () => {
+    assert.equal((await state(vid)).mode, 'collapsed')
+    await vid.evaluate(() => document.getElementById('v').play()); await sleep(2500)
+    assert.equal((await state(vid)).mode, 'collapsed')
+  })
+  await vid.close()
+  const src = await x.open(`${BASE}/media.html`); await sleep(600)
+  await step('loaded-but-unplayed media is not announced', async () => assert.equal((await state(src)).mode, 'collapsed'))
+  await src.evaluate(() => window.start())
+  await step('playing media shows the compact media-active notch with title and a blue accent', async () => {
+    await waitState(src, (s) => s.mode === 'compact' && s.barTitle === 'Test Track', 'compact pill')
+    const s = await waitState(src, (s) => hueOf(s.accent) > 200 && hueOf(s.accent) < 245 && s.accent !== '#d4f11e', 'blue accent (after the fade)', 6000)
+    assert.ok(s.rect.w > 300 && s.rect.h <= 40, JSON.stringify(s.rect))
+    await src.screenshot({ path: join(SHOTS, '01-compact.png'), clip: { x: 340, y: 0, width: 600, height: 90 } })
+  })
+  const obs = await x.open(`${BASE}/plain.html`)
+  await step('a different tab shows the same media notch, and artwork is painted from the worker-fetched thumbnail', async () => { const s = await waitState(obs, (s) => s.mode === 'compact' && s.artPainted, 'pill + art in other tab'); assert.equal(s.barTitle, 'Test Track') })
+  await step('hovering the pill opens the mini player (not the search panel)', async () => {
+    await obs.locator('.dsn-shell').hover(); const s = await waitState(obs, (s) => s.mode === 'peek', 'peek')
+    assert.equal(s.searchVisible, false); await obs.screenshot({ path: join(SHOTS, '02-peek.png'), clip: { x: 300, y: 0, width: 680, height: 110 } })
+  })
+  await step('mini player controls are real: pause then play reaches the source tab', async () => {
+    await obs.locator('.peek-controls .play-btn').click(); await sleep(500); assert.equal(await src.evaluate(() => document.getElementById('a').paused), true)
+    await waitState(obs, (s) => !s.playing || true, 'state'); await obs.locator('.peek-controls .play-btn').click(); await sleep(500); assert.equal(await src.evaluate(() => document.getElementById('a').paused), false)
+  })
+  await step('previous/next are disabled when the site does not offer them (honest controls)', async () => {
+    assert.equal(await obs.locator('.peek-controls .ctrl').first().isDisabled(), true); assert.equal(await obs.locator('.peek-controls .ctrl').nth(2).isDisabled(), true)
+  })
+  await step('clicking the title opens the full Media view; Media tab is present', async () => {
+    await obs.locator('.peek-meta').click(); const s = await waitState(obs, (s) => s.mode === 'panel' && s.mediaVisible, 'media view')
+    assert.equal(s.view, 'media'); await obs.screenshot({ path: join(SHOTS, '03-media-view.png'), clip: { x: 300, y: 0, width: 680, height: 400 } })
+  })
+  await step('seek, repeat and mute act on the real media element', async () => {
+    const before = await src.evaluate(() => document.getElementById('a').currentTime)
+    await obs.locator('.dsn-media input[type=range]').first().evaluate((el) => { el.value = '40'; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })) })
+    await sleep(600); const t = await src.evaluate(() => document.getElementById('a').currentTime); assert.ok(t >= 39 && t < 46, `seeked ${before} -> ${t}`)
+    await obs.locator('.controls .ctrl').first().click(); await sleep(500); assert.equal(await src.evaluate(() => document.getElementById('a').loop), false, 'repeat did not turn loop off')
+    await obs.locator('.vol .ctrl').click(); await sleep(500); assert.equal(await src.evaluate(() => document.getElementById('a').muted), true)

+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { normalizeHost, hostMatches, isBlockedHost } from '../../src/shared/hosts.ts'
+
+test('normalizes urls and bare hosts', () => {
+  assert.equal(normalizeHost('https://www.Example.com/a?b=1'), 'example.com')
+  assert.equal(normalizeHost('  reddit.com '), 'reddit.com')
+  assert.equal(normalizeHost('news.ycombinator.com'), 'news.ycombinator.com')
+  assert.equal(normalizeHost('localhost'), 'localhost')
+})
+test('rejects unusable input', () => {
+  for (const bad of ['', '   ', 'javascript:alert(1)', 'chrome://settings', 'file:///etc/passwd', 'not a host', 'a..b', '-bad.com', 'exa mple.com', 'singlelabel']) assert.equal(normalizeHost(bad), null, bad)
+})
+test('matches subdomains but not look-alikes', () => {
+  assert.ok(hostMatches('m.youtube.com', 'youtube.com'))
+  assert.ok(hostMatches('youtube.com', 'youtube.com'))
+  assert.ok(!hostMatches('notyoutube.com', 'youtube.com'))
+  assert.ok(!hostMatches('youtube.com.evil.io', 'youtube.com'))
+  assert.ok(isBlockedHost('a.b.reddit.com', ['x.com', 'reddit.com']))
+})
+test('numbers and IPs are not sites', () => { for (const bad of ['7', '192.168.0.1', '0.0.0.7', 'http://10.0.0.2/']) assert.equal(normalizeHost(bad), null, bad) })

@@ -0,0 +1,45 @@
+import { normalizeHost } from '../shared/hosts.ts'
+import './blocked.css'
+
+const params = new URLSearchParams(location.search)
+const host = normalizeHost(params.get('site') ?? '')
+const strict = params.get('strict') === '1'
+const app = document.getElementById('app')!
+
+const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> & { class?: string } = {}, ...kids: (Node | string)[]) => {
+  const node = document.createElement(tag)
+  const { class: className, ...rest } = props as Record<string, unknown>
+  if (className) node.className = String(className)
+  Object.assign(node, rest)
+  node.append(...kids)
+  return node
+}
+
+const status = el('p', { class: 'status', role: 'status' })
+const back = el('button', { class: 'primary', type: 'button' }, 'Go back')
+back.addEventListener('click', () => {
+  if (history.length > 1) history.back()
+  else location.replace(chrome.runtime.getURL('notchtab.html'))
+})
+const actions = el('div', { class: 'actions' }, back)
+
+if (host && !strict) {
+  const proceed = el('button', { class: 'quiet', type: 'button' }, 'Continue anyway')
+  proceed.addEventListener('click', async () => {
+    proceed.disabled = true
+    const result = (await chrome.runtime.sendMessage({ t: 'focus-allow', host }).catch(() => null)) as { ok?: boolean } | null
+    if (result?.ok) location.replace(`https://${host}/`)
+    else { status.textContent = 'Focus Mode wouldn\u2019t let this through. Check Settings > Focus.'; proceed.disabled = false }
+  })
+  actions.append(proceed)
+}
+
+app.append(
+  el('div', { class: 'mark', 'aria-hidden': 'true' } as never, '\u25cf'),
+  el('p', { class: 'kicker' }, 'Focus Mode'),
+  el('h1', {}, host ? `${host} is blocked` : 'This site is blocked'),
+  el('p', { class: 'lede' }, strict ? 'Strict mode is on, so there\u2019s no way around it from here. You can change this in DSN settings.' : 'You asked DSN to keep you away from this site. Take a breath, or continue if you really need it.'),
+  actions,
+  status,
+)
+document.title = host ? `${host} is blocked` : 'Blocked by Focus Mode'

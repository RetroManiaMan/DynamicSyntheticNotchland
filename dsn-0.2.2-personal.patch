@@ -0,0 +1,36 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { extractAccent, contrast, parseHex, rgbToHsl, NEUTRAL_ACCENT } from '../../src/shared/color.ts'
+
+const fill = (rgb: [number, number, number], n = 400, a = 255) => Array.from({ length: n }).flatMap(() => [...rgb, a])
+const hueOf = (hex: string) => rgbToHsl(parseHex(hex)!)[0] * 360
+const near = (actual: number, expected: number, tol: number) => assert.ok(Math.abs(actual - expected) <= tol, `${actual} not within ${tol} of ${expected}`)
+
+test('blue artwork gives a blue accent', () => near(hueOf(extractAccent(fill([30, 80, 220]))), 224, 12))
+test('red artwork gives a red accent', () => { const h = hueOf(extractAccent(fill([210, 40, 60]))); assert.ok(h < 12 || h > 348, `hue ${h}`) })
+test('purple artwork gives a purple accent', () => near(hueOf(extractAccent(fill([140, 60, 220]))), 275, 15))
+test('orange artwork gives an orange accent', () => near(hueOf(extractAccent(fill([240, 140, 30]))), 33, 12))
+test('green artwork gives a green accent', () => near(hueOf(extractAccent(fill([40, 200, 80]))), 140, 15))
+
+test('every accent keeps readable contrast on the DSN surface', () => {
+  for (const rgb of [[30, 80, 220], [10, 10, 200], [200, 30, 30], [120, 0, 200], [20, 120, 20], [250, 240, 20]] as [number, number, number][]) {
+    const accent = parseHex(extractAccent(fill(rgb)))!
+    assert.ok(contrast(accent, [10, 10, 12]) >= 4.5, `${rgb} -> ${accent}`)
+  }
+})
+
+test('greyscale, black, white and empty artwork fall back to the neutral accent', () => {
+  for (const data of [fill([128, 128, 128]), fill([0, 0, 0]), fill([255, 255, 255]), fill([30, 30, 34]), []]) assert.equal(extractAccent(data), NEUTRAL_ACCENT)
+})
+
+test('transparent pixels are ignored', () => assert.equal(extractAccent(fill([30, 80, 220], 400, 0)), NEUTRAL_ACCENT))
+
+test('multicolour artwork picks the dominant hue, not the average', () => {
+  const data = [...fill([30, 80, 220], 300), ...fill([210, 40, 60], 60), ...fill([255, 255, 255], 200)]
+  near(hueOf(extractAccent(data)), 224, 14)
+})
+
+test('mostly dark art with a small vivid region still yields that hue', () => {
+  const data = [...fill([8, 8, 10], 500), ...fill([240, 140, 30], 40)]
+  near(hueOf(extractAccent(data)), 33, 14)
+})

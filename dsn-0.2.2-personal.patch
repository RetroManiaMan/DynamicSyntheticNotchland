+  window.addEventListener('keydown', onKey, true)
+  for (const type of ['keydown', 'keyup', 'keypress']) host.addEventListener(type, (event) => event.stopPropagation()) // keep page hotkeys out of our inputs
+  const onResize = () => layout()
+  window.addEventListener('resize', onResize)
+  const resizeObserver = new ResizeObserver(() => layout())
+  resizeObserver.observe(shell)
+  const ensureAttached = () => { if (!host.isConnected && document.documentElement) document.documentElement.append(host) }
+  document.addEventListener('DOMContentLoaded', ensureAttached)
+  window.addEventListener('pageshow', ensureAttached)
+  clockTimer = window.setInterval(() => { const t = clockText(); clock.textContent = t; bigClock.textContent = t; bigDate.textContent = dateText() }, 15_000)
+
+  // ---------- data sources ----------
+  const applySettings = (settings: DsnSettings) => {
+    S.settings = settings
+    anchor.dataset.placement = settings.placement
+    anchor.dataset.amoled = String(settings.amoled)
+    updateAccent(); render()
+  }
+  const applySessions = (sessions: SessionView[]) => {
+    S.sessions = sessions
+    S.session = pickCurrent(sessions, Date.now())
+    updateMedia(); updateAccent()
+  }
+  void loadSettings().then(applySettings)
+  const stopSettings = watchSettings(applySettings)
+  void getLibrary().then((items) => { S.library = items; updateMedia() })
+  const stopLibrary = watchLibrary((items) => { S.library = items; updateMedia() })
+  const stopHub = watchHub(applySessions)
+
+  document.documentElement.append(host)
+  render()
+
+  return () => {
+    stopSettings(); stopLibrary(); stopHub(); accent.stop(); resizeObserver.disconnect()
+    window.clearInterval(tickTimer); window.clearInterval(clockTimer); window.clearTimeout(leaveTimer); window.clearTimeout(hoverTimer); window.clearTimeout(saveTimer)
+    document.removeEventListener('pointerdown', onOutside, true); window.removeEventListener('keydown', onKey, true); window.removeEventListener('resize', onResize)
+    host.remove()
+  }
+}
diff --git a/src/content/source.ts b/src/content/source.ts
new file mode 100644
index 0000000..16aa07b
--- /dev/null
+++ b/src/content/source.ts
@@ -0,0 +1,178 @@
+import type { MediaAction, SourceSnapshot, ToSource, ToWorker } from '../shared/protocol.ts'
+
+/**
+ * Reports this frame's media to the service worker. Runs in every frame, costs nothing until a media element
+ * actually plays, and only reports media a person would call "media": not muted background clips, not
+ * short UI sounds, not elements that never played.
+ */
+const MIN_DURATION = 30 // seconds; metadata-less clips shorter than this are treated as UI/ambient video
+
+let primary: HTMLMediaElement | null = null
+let reported = false
+let lastSignature = ''
+let pageActions = new Set<string>()
+let flushTimer = 0, pollTimer = 0, heartbeatTimer = 0
+
+function post(message: ToWorker): void {
+  try {
+    if (!chrome.runtime?.id) return
+    void chrome.runtime.sendMessage(message).catch(() => {})
+  } catch { /* extension context invalidated (e.g. extension reloaded) */ }
+}
+
+const readMetadata = (): MediaMetadata | null => {
+  try { return navigator.mediaSession?.metadata ?? null } catch { return null }
+}
+
+function audible(el: HTMLMediaElement): boolean {
+  if (el.muted || el.volume === 0) return false
+  if (el instanceof HTMLVideoElement) {
+    const decoded = (el as any).webkitAudioDecodedByteCount // Chrome-only; 0 after playback began means a silent video
+    if (typeof decoded === 'number' && el.currentTime > 1.5 && decoded === 0) return false
+  }
+  return true
+}
+
+function eligible(el: HTMLMediaElement, meta: MediaMetadata | null): boolean {
+  if (el.error || !el.isConnected) return false
+  const hasPlayed = el.played.length > 0 || !el.paused
+  if (!hasPlayed) return false // loaded-but-never-played elements are not "media in use"
+  if (meta?.title) return true // the page itself describes this as media
+  const duration = el.duration
+  return (duration >= MIN_DURATION || duration === Infinity) && audible(el)
+}
+
+function pickArtwork(meta: MediaMetadata | null): string | null {
+  const list = meta?.artwork
+  if (!list?.length) return null
+  const area = (sizes: string) => {
+    const [w, h] = String(sizes || '').split('x').map(Number)
+    return (w || 0) * (h || 0)
+  }
+  const best = [...list].sort((a, b) => area(b.sizes ?? '') - area(a.sizes ?? ''))[0]
+  try { return best?.src ? new URL(best.src, document.baseURI).href : null } catch { return null }
+}
+
+function snapshot(): SourceSnapshot | null {
+  const el = primary
+  if (!el) return null
+  const meta = readMetadata()
+  if (!eligible(el, meta)) return null
+  const duration = Number.isFinite(el.duration) && el.duration > 0 ? el.duration : null
+  return {
+    title: (meta?.title || document.title || location.hostname).trim().slice(0, 200),
+    artist: (meta?.artist || location.hostname).trim().slice(0, 200),
+    album: (meta?.album || '').trim().slice(0, 200),
+    artworkUrl: pickArtwork(meta),
+    playing: !el.paused && !el.ended,
+    position: el.currentTime, at: Date.now(), duration, rate: el.playbackRate || 1,
+    muted: el.muted, volume: el.volume, repeat: el.loop,
+    caps: { play: true, seek: !!duration, previous: pageActions.has('previoustrack'), next: pageActions.has('nexttrack'), volume: true, repeat: !!duration },
+    host: location.hostname, pageUrl: location.href,
+  }
+}
+
+const signatureOf = (s: SourceSnapshot) =>
+  [s.title, s.artist, s.album, s.artworkUrl, s.playing, s.duration, s.rate, s.muted, s.volume, s.repeat, s.caps.previous, s.caps.next].join('\u0001')
+
+function flush(force: boolean): void {
+  const snap = snapshot()
+  if (!snap) {
+    if (reported) { reported = false; lastSignature = ''; post({ t: 'gone' }) }
+    if (!primary || !primary.isConnected) stopTimers()
+    return
+  }
+  const signature = signatureOf(snap)
+  if (!force && signature === lastSignature) return
+  lastSignature = signature
+  reported = true
+  post({ t: 'snapshot', snap })
+}
+
+function schedule(force: boolean): void {
+  window.clearTimeout(flushTimer)
+  flushTimer = window.setTimeout(() => flush(force), 80)
+}
+
+function startTimers(): void {
+  if (!pollTimer) pollTimer = window.setInterval(() => {
+    if (primary && !primary.isConnected) primary = null
+    flush(false) // catches metadata changes, which have no event
+  }, 1000)
+  if (!heartbeatTimer) heartbeatTimer = window.setInterval(() => { if (primary && !primary.paused) flush(true) }, 30_000)
+}
+function stopTimers(): void {
+  window.clearInterval(pollTimer); window.clearInterval(heartbeatTimer)
+  pollTimer = 0; heartbeatTimer = 0
+}
+
+function invokePageAction(action: string, extra: object = {}): void {
+  window.dispatchEvent(new CustomEvent('dsn:invoke', { detail: JSON.stringify({ action, ...extra }) }))
+}
+
+function run(action: MediaAction, value?: number | boolean): void {
+  const el = primary
+  switch (action) {
+    case 'play':
+      if (el) void el.play().catch(() => {})
+      else invokePageAction('play')
+      break
+    case 'pause':
+      if (el) el.pause()
+      else invokePageAction('pause')
+      break
+    case 'toggle':
+      if (el?.paused) void el.play().catch(() => {})
+      else el?.pause()
+      break
+    case 'seek':
+      if (el && typeof value === 'number' && Number.isFinite(value)) el.currentTime = Math.max(0, Math.min(value, Number.isFinite(el.duration) ? el.duration : value))
+      break
+    case 'previous': invokePageAction('previoustrack'); break
+    case 'next': invokePageAction('nexttrack'); break
+    case 'mute': if (el) el.muted = typeof value === 'boolean' ? value : !el.muted; break
+    case 'volume': if (el && typeof value === 'number' && Number.isFinite(value)) { el.volume = Math.min(1, Math.max(0, value)); if (value > 0) el.muted = false } break
+    case 'repeat': if (el) el.loop = typeof value === 'boolean' ? value : !el.loop; break
+  }
+  schedule(true)
+}
+
+export function startSource(): void {
+  const onMedia = (event: Event) => {
+    const el = event.target
+    if (!(el instanceof HTMLMediaElement)) return
+    const type = event.type
+    if ((type === 'playing' || type === 'play') && el !== primary) {
+      // Only something that qualifies as media may take over. A notification ping or a muted clip must not
+      // replace a real session that is already playing.
+      const meta = readMetadata()
+      if (!eligible(el, meta)) return
+      const substantial = (e: HTMLMediaElement) => e.duration >= MIN_DURATION || e.duration === Infinity
+      // Even with page metadata, a short clip must not steal the notch from a long-form element that is playing.
+      if (primary && !primary.paused && eligible(primary, meta) && !substantial(el)) return
+      primary = el; startTimers()
+    }
+    if (el !== primary) return
+    if (type === 'emptied') { schedule(true); return }
+    schedule(true)
+  }
+  for (const type of ['play', 'playing', 'pause', 'ended', 'seeked', 'ratechange', 'volumechange', 'durationchange', 'emptied']) {
+    document.addEventListener(type, onMedia, true) // media events don't bubble; capture sees them all
+  }
+
+  window.addEventListener('dsn:actions', (event) => {
+    try { pageActions = new Set(JSON.parse(String((event as CustomEvent).detail)) as string[]) } catch { /* ignore */ }
+    if (primary) schedule(false)
+  })
+  window.dispatchEvent(new Event('dsn:query'))
+
+  window.addEventListener('pageshow', (event) => { if ((event as PageTransitionEvent).persisted) schedule(true) })
+  window.addEventListener('pagehide', () => { if (reported) post({ t: 'gone' }) })
+
+  try {
+    chrome.runtime.onMessage.addListener((message: ToSource, sender) => {
+      if (sender.id !== chrome.runtime.id || message?.t !== 'command') return
+      run(message.action, message.value)
+    })
+  } catch { /* invalidated context */ }
+}

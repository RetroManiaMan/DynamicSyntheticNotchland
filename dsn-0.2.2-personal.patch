+/**
+ * Draws the service worker's pre-fetched thumbnail onto <canvas> elements.
+ * Using canvas (not <img src>) means page CSP img-src rules can't block artwork, and no tab touches a third-party URL.
+ */
+const decoded = new Map<string, Promise<ImageBitmap | null>>()
+
+function decode(base64: string): Promise<ImageBitmap | null> {
+  const key = `${base64.length}:${base64.slice(0, 48)}:${base64.slice(-48)}`
+  let hit = decoded.get(key)
+  if (!hit) {
+    hit = (async () => {
+      try {
+        const binary = atob(base64)
+        const bytes = new Uint8Array(binary.length)
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)
+        return await createImageBitmap(new Blob([bytes]))
+      } catch { return null }
+    })()
+    decoded.set(key, hit)
+    while (decoded.size > 6) decoded.delete(decoded.keys().next().value as string)
+  }
+  return hit
+}
+
+export async function paintThumb(canvas: HTMLCanvasElement, base64: string | null): Promise<boolean> {
+  const ctx = canvas.getContext('2d')
+  if (!ctx) return false
+  if (!base64) { ctx.clearRect(0, 0, canvas.width, canvas.height); return false }
+  const bitmap = await decode(base64)
+  if (!bitmap) return false
+  ctx.clearRect(0, 0, canvas.width, canvas.height)
+  ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height)
+  return true
+}
diff --git a/src/content/commands.ts b/src/content/commands.ts
new file mode 100644
index 0000000..c7c7b29
--- /dev/null
+++ b/src/content/commands.ts
@@ -0,0 +1,55 @@
+import { normalizeHost } from '../shared/hosts.ts'
+
+export type RouteResult =
+  | { kind: 'empty' }
+  | { kind: 'search'; query: string }
+  | { kind: 'error'; message: string }
+  | { kind: 'help'; message: string }
+  | { kind: 'browser'; action: { type: 'open'; url: string } | { type: 'newtab' }; message: string }
+  | { kind: 'focus'; op: 'block' | 'unblock'; host: string | null }
+
+export const HELP = 'Commands: /search <query>, /open <url>, /newtab, /block [site], /unblock <site>, /help'
+
+export function parse(input: string) {
+  const trimmed = input.trim()
+  if (!trimmed) return { type: 'empty' as const }
+  if (!trimmed.startsWith('/')) return { type: 'search' as const, query: trimmed }
+  const tokens = trimmed.slice(1).trim().split(/\s+/).filter(Boolean)
+  return { type: 'command' as const, command: (tokens[0] || '').toLowerCase(), args: tokens.slice(1) }
+}
+
+export function route(input: string): RouteResult {
+  const parsed = parse(input)
+  if (parsed.type === 'empty') return { kind: 'empty' }
+  if (parsed.type === 'search') return { kind: 'search', query: parsed.query }
+  const argument = parsed.args.join(' ')
+  switch (parsed.command) {
+    case 'search':
+      return argument ? { kind: 'search', query: argument } : { kind: 'error', message: '/search requires a query.' }
+    case 'open': {
+      if (!argument) return { kind: 'error', message: '/open requires a URL.' }
+      try {
+        const normalized = argument.includes('://') ? argument : `https://${argument}`
+        const url = new URL(normalized)
+        if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new Error('protocol')
+        return { kind: 'browser', action: { type: 'open', url: normalized }, message: `Opening ${url.hostname}...` }
+      } catch {
+        return { kind: 'error', message: "That doesn't appear to be a valid URL." }
+      }
+    }
+    case 'newtab':
+      return { kind: 'browser', action: { type: 'newtab' }, message: 'Opening a new tab...' }
+    case 'block':
+    case 'unblock': {
+      const host = argument ? normalizeHost(argument) : null
+      if (argument && !host) return { kind: 'error', message: `"${argument}" isn't a site I can use. Try something like example.com.` }
+      if (parsed.command === 'unblock' && !host) return { kind: 'error', message: '/unblock needs a site, like /unblock example.com.' }
+      return { kind: 'focus', op: parsed.command, host }
+    }
+    case 'help':
+    case 'commands':
+      return { kind: 'help', message: HELP }
+    default:
+      return { kind: 'error', message: 'Unknown command. Try /help.' }
+  }
+}

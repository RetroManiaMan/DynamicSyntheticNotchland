+<!doctype html><html><head><meta charset="utf-8"><title>Fixture: media with prev/next</title></head>
+<body><h1 id="s">idle</h1><audio id="a" src="tone.mp3"></audio>
+<script>
+const a = document.getElementById('a'); window.log = [];
+navigator.mediaSession.metadata = new MediaMetadata({ title: 'Handler Track', artist: 'Handler Artist', artwork: [{ src: 'art-red.png', sizes: '512x512' }] });
+navigator.mediaSession.setActionHandler('nexttrack', () => { window.log.push('next'); document.title = 'next'; });
+navigator.mediaSession.setActionHandler('previoustrack', () => { window.log.push('previous'); document.title = 'previous'; });
+window.start = () => a.play();
+</script></body></html>

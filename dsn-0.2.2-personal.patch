@@ -0,0 +1,29 @@
+import { HUB_KEY, type HubStored, type SessionView, type ToWorker } from '../shared/protocol.ts'
+
+export function send<T = unknown>(message: ToWorker): Promise<T | null> {
+  try {
+    if (!chrome.runtime?.id) return Promise.resolve(null)
+    return chrome.runtime.sendMessage(message).then((r) => r as T, () => null)
+  } catch {
+    return Promise.resolve(null)
+  }
+}
+
+/**
+ * Observes the media hub. Asking the worker once wakes it (and grants session-storage access);
+ * after that, every change arrives through storage events, which fire even if the worker is asleep.
+ */
+export function watchHub(onSessions: (sessions: SessionView[]) => void): () => void {
+  let latest = -1
+  const apply = (stored: HubStored | undefined | null) => {
+    if (!stored || typeof stored.rev !== 'number' || stored.rev < latest) return
+    latest = stored.rev
+    onSessions(Array.isArray(stored.sessions) ? stored.sessions : [])
+  }
+  const listener = (changes: Record<string, chrome.storage.StorageChange>, area: string) => {
+    if (area === 'session' && changes[HUB_KEY]) apply(changes[HUB_KEY].newValue as HubStored | undefined)
+  }
+  try { chrome.storage.onChanged.addListener(listener) } catch { /* invalidated */ }
+  void send<HubStored>({ t: 'hub:get' }).then(apply)
+  return () => { try { chrome.storage.onChanged.removeListener(listener) } catch { /* invalidated */ } }
+}

index 0000000..b28f652
--- /dev/null
+++ b/src/shared/lrc.ts
@@ -0,0 +1,28 @@
+export interface LrcLine { t: number; text: string }
+
+const TAG = /\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]/g
+
+/** Parses LRC ("[mm:ss.xx] line") into time-sorted lines. Metadata tags like [ar:...] are ignored. */
+export function parseLrc(source: string): LrcLine[] {
+  const lines: LrcLine[] = []
+  for (const row of String(source ?? '').split(/\r?\n/)) {
+    const stamps = [...row.matchAll(TAG)]
+    if (!stamps.length) continue
+    const text = row.replace(TAG, '').trim()
+    for (const stamp of stamps) {
+      const frac = stamp[3] ? Number(`0.${stamp[3]}`) : 0
+      lines.push({ t: Number(stamp[1]) * 60 + Number(stamp[2]) + frac, text })
+    }
+  }
+  return lines.sort((a, b) => a.t - b.t)
+}
+
+/** Index of the line active at time `t` (seconds), or -1 before the first line. */
+export function lineIndexAt(lines: readonly LrcLine[], t: number): number {
+  let lo = 0, hi = lines.length - 1, found = -1
+  while (lo <= hi) {
+    const mid = (lo + hi) >> 1
+    if (lines[mid]!.t <= t) { found = mid; lo = mid + 1 } else hi = mid - 1
+  }
+  return found
+}

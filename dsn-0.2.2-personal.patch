+import { useCallback, useEffect, useState, type FormEvent } from 'react'
+import { normalizeHost } from '../shared/hosts.ts'
+import { clearLibrary, getLibrary, removeFromLibrary, watchLibrary, type LibraryItem } from '../shared/library.ts'
+import { DEFAULT_SETTINGS, loadSettings, saveSettings, watchSettings, type DsnSettings, type Placement } from '../shared/settings.ts'
+import { Note, Row, Segmented, Switch } from './ui.tsx'
+
+const SECTIONS = [
+  { id: 'general', label: 'General' },
+  { id: 'appearance', label: 'Appearance' },
+  { id: 'notch', label: 'Notch' },
+  { id: 'search', label: 'Search' },
+  { id: 'media', label: 'Media' },
+  { id: 'focus', label: 'Focus' },
+  { id: 'shortcuts', label: 'Shortcuts' },
+  { id: 'privacy', label: 'Privacy' },
+  { id: 'account', label: 'Account' },
+] as const
+type SectionId = (typeof SECTIONS)[number]['id']
+
+const fromHash = (): SectionId => {
+  const id = location.hash.replace('#', '')
+  return SECTIONS.some((section) => section.id === id) ? (id as SectionId) : 'general'
+}
+
+function useSettings() {
+  const [settings, setSettings] = useState<DsnSettings | null>(null)
+  useEffect(() => {
+    void loadSettings().then(setSettings)
+    return watchSettings(setSettings)
+  }, [])
+  const update = useCallback(async (patch: Partial<DsnSettings>) => setSettings(await saveSettings(patch)), [])
+  return [settings, update] as const
+}
+
+export function App() {
+  const [settings, update] = useSettings()
+  const [section, setSection] = useState<SectionId>(fromHash)
+  useEffect(() => {
+    const onHash = () => setSection(fromHash())
+    window.addEventListener('hashchange', onHash)
+    return () => window.removeEventListener('hashchange', onHash)
+  }, [])
+  if (!settings) return null
+  const go = (id: SectionId) => { setSection(id); history.replaceState(null, '', `#${id}`) }
+
+  return (
+    <div className="shell">
+      <aside className="side">
+        <div className="brand"><span className="brand-dot" />Notchland<small>v{chrome.runtime.getManifest().version}</small></div>
+        <nav aria-label="Settings sections">
+          {SECTIONS.map((item) => (
+            <button key={item.id} type="button" className={item.id === section ? 'is-active' : ''} aria-current={item.id === section ? 'page' : undefined} onClick={() => go(item.id)}>
+              {item.label}
+            </button>
+          ))}
+        </nav>
+      </aside>
+      <main className="content" id={section}>
+        <h1>{SECTIONS.find((item) => item.id === section)!.label}</h1>
+        {section === 'general' && <General settings={settings} update={update} />}
+        {section === 'appearance' && <Appearance settings={settings} update={update} />}
+        {section === 'notch' && <NotchSection settings={settings} update={update} />}
+        {section === 'search' && <Search />}
+        {section === 'media' && <Media settings={settings} update={update} />}
+        {section === 'focus' && <Focus settings={settings} update={update} />}
+        {section === 'shortcuts' && <Shortcuts />}
+        {section === 'privacy' && <Privacy />}
+        {section === 'account' && <Account />}
+      </main>
+    </div>
+  )
+}
+
+type P = { settings: DsnSettings; update: (patch: Partial<DsnSettings>) => Promise<void> }
+
+function General({ settings, update }: P) {
+  return (
+    <section>
+      <Row title="Feedback prompts" hint="Occasionally ask if you have feedback on the new tab page. Never more than once a month, and never in the first couple of visits.">
+        <Switch label="Feedback prompts" checked={settings.feedbackPromptsEnabled} onChange={(feedbackPromptsEnabled) => void update({ feedbackPromptsEnabled })} />
+      </Row>
+      <Note>Everything here works without an account. Settings are stored in this browser.</Note>
+    </section>
+  )
+}
+
+function Appearance({ settings, update }: P) {
+  return (
+    <section>
+      <Row title="True black (AMOLED)" hint="Use pure black for the notch surfaces instead of DSN’s near-black, and drop the accent wash. Best on OLED screens.">
+        <Switch label="True black surfaces" checked={settings.amoled} onChange={(amoled) => void update({ amoled })} />
+      </Row>
+    </section>
+  )
+}
+
+const PLACEMENT_OPTIONS: { value: Placement; label: string }[] = [
+  { value: 'top', label: 'Top' }, { value: 'bottom', label: 'Bottom' }, { value: 'left', label: 'Left' }, { value: 'right', label: 'Right' }, { value: 'free', label: 'Free' },
+]
+
+function NotchSection({ settings, update }: P) {
+  return (
+    <section>
+      <Row title="Placement" hint="Where the notch sits on a page. Free lets you drag it anywhere; the position is remembered.">
+        <Segmented label="Placement" value={settings.placement} options={PLACEMENT_OPTIONS} onChange={(placement) => void update({ placement })} />
+      </Row>
+      {settings.placement === 'free' && (
+        <Row title="Free position" hint="Drag the notch on any page, or focus its grip button and use the arrow keys (Shift for bigger steps).">
+          <button type="button" className="btn" onClick={() => void update({ freePosition: DEFAULT_SETTINGS.freePosition })}>Reset position</button>
+        </Row>
+      )}
+    </section>
+  )
+}
+
+function Search() {
+  return (
+    <section>
+      <Row title="Search provider" hint="Search from the notch or new tab opens Google in a new tab." />
+      <Note>There are no search settings yet. When there are, they’ll appear here.</Note>
+    </section>
+  )
+}
+
+function Media({ settings, update }: P) {
+  const [library, setLibrary] = useState<LibraryItem[]>([])
+  useEffect(() => {
+    void getLibrary().then(setLibrary)
+    return watchLibrary(setLibrary)
+  }, [])
+  return (
+    <section>
+      <Row title="Dynamic media accent" hint="Tint the media notch and controls with a colour taken from the artwork. The rest of DSN stays green.">
+        <Switch label="Dynamic media accent" checked={settings.dynamicMediaAccent} onChange={(dynamicMediaAccent) => void update({ dynamicMediaAccent })} />
+      </Row>
+      <Row title="Lyrics" hint={<>Show synced lyrics in the media view. <strong>When on, DSN sends the track title, artist and length to LRCLIB (lrclib.net)</strong> to look them up, only after you open lyrics for a track. Off by default.</>}>
+        <Switch label="Lyrics" checked={settings.lyricsEnabled} onChange={(lyricsEnabled) => void update({ lyricsEnabled })} />
+      </Row>
+      <Row title="Library" hint="Tracks you favorite or save from the media view. Stored in this browser only; nothing is synced.">
+        {library.length > 0 && <button type="button" className="btn" onClick={() => void clearLibrary().then(() => setLibrary([]))}>Clear all</button>}
+      </Row>
+      {library.length === 0 ? <Note>Nothing saved yet.</Note> : (
+        <ul className="list">
+          {library.map((item) => (
+            <li key={item.id}>
+              <div className="list-main">
+                <span className="list-title">{item.title}</span>
+                <span className="list-sub">{[item.artist, item.host].filter(Boolean).join(' · ')}{item.favorite ? ' · favorite' : ''}{item.saved ? ' · saved' : ''}</span>
+              </div>
+              {item.pageUrl && <a className="btn" href={item.pageUrl} target="_blank" rel="noopener noreferrer">Open</a>}
+              <button type="button" className="btn" onClick={() => void removeFromLibrary(item.id).then(setLibrary)}>Remove</button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
+
+function Focus({ settings, update }: P) {
+  const [draft, setDraft] = useState('')
+  const [error, setError] = useState('')
+  const { focus } = settings
+  const add = (event: FormEvent) => {
+    event.preventDefault()
+    const host = normalizeHost(draft)
+    if (!host) { setError('Enter a site like example.com.'); return }
+    setError(''); setDraft('')
+    if (!focus.sites.includes(host)) void update({ focus: { ...focus, sites: [...focus.sites, host] } })
+  }
+  return (
+    <section>
+      <Row title="Focus Mode" hint="Blocks navigating to the sites below (and their subdomains) and shows a calm page instead. It’s a self-control tool, not a lock: you can always change it here.">
+        <Switch label="Focus Mode" checked={focus.enabled} onChange={(enabled) => void update({ focus: { ...focus, enabled } })} />
+      </Row>
+      <Row title="Strict mode" hint="Removes “Continue anyway” from the blocked page and stops /unblock in the notch.">
+        <Switch label="Strict mode" checked={focus.strict} onChange={(strict) => void update({ focus: { ...focus, strict } })} />
+      </Row>
+      <form className="add" onSubmit={add}>
+        <input aria-label="Site to block" placeholder="example.com" value={draft} onChange={(event) => { setDraft(event.target.value); setError('') }} />
+        <button type="submit" className="btn primary">Block site</button>
+      </form>
+      {error && <p className="error" role="alert">{error}</p>}
+      {focus.sites.length === 0 ? <Note>No sites yet. You can also type /block in the notch to block the page you’re on.</Note> : (
+        <ul className="list">
+          {focus.sites.map((site) => (
+            <li key={site}>
+              <div className="list-main"><span className="list-title">{site}</span></div>
+              <button type="button" className="btn" onClick={() => void update({ focus: { ...focus, sites: focus.sites.filter((entry) => entry !== site) } })}>Remove</button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
+
+function Shortcuts() {
+  return (
+    <section>
+      <Row title="In the notch" hint={<><kbd>Esc</kbd> closes it. In Free placement, focus the grip button and use the arrow keys to move it.</>} />
+      <Note>Global media hotkeys and custom shortcuts aren’t available yet.</Note>
+    </section>
+  )
+}
+
+function Privacy() {
+  return (
+    <section>
+      <Row title="What stays on your device" hint="Settings, your library, Focus Mode sites and any feedback you write are stored locally in this browser. DSN has no analytics and doesn’t upload your browsing history or page contents." />
+      <Row title="What can leave your device" hint="Only if you turn on lyrics: the title, artist and length of a track you opened lyrics for, sent to LRCLIB. Artwork is fetched from the site that is playing the media." />
+      <Row title="Why DSN asks to read all sites" hint="So the notch can appear on pages and notice when a page is playing media. DSN reads media title, artist, artwork and playback state only. It doesn’t read page text or forms." />
+      <Row title="Why it can block sites" hint="Focus Mode uses the browser’s network rules to redirect the sites you list. It never reads or changes the pages you visit." />
+    </section>
+  )
+}
+
+function Account() {
+  return (
+    <section>
+      <Row title="Signed out" hint="DSN doesn’t have an account service yet, so there’s nothing to sign in to. Everything works locally without one." />
+      <Note>When accounts arrive they’ll be optional, and your local settings and library won’t be lost.</Note>
+    </section>
+  )
+}

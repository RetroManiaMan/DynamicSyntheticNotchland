+export interface PositionSample { position: number; at: number; rate: number; playing: boolean; duration: number | null }
+
+/** Playback position now, extrapolated from the last report. Avoids per-tick messaging. */
+export function projectPosition(s: PositionSample, now: number): number {
+  const raw = s.playing ? s.position + ((now - s.at) / 1000) * s.rate : s.position
+  const clamped = Math.max(0, raw)
+  return s.duration && Number.isFinite(s.duration) ? Math.min(clamped, s.duration) : clamped
+}
+
+export function formatTime(seconds: number): string {
+  if (!Number.isFinite(seconds) || seconds < 0) return '0:00'
+  const total = Math.floor(seconds)
+  const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60
+  return h ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${m}:${String(s).padStart(2, '0')}`
+}

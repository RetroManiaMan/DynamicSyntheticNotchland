--- /dev/null
+++ b/src/shared/settings.ts
@@ -0,0 +1,81 @@
+import { normalizeHost } from './hosts.ts'
+
+export const SETTINGS_KEY = 'dsn-settings-v1'
+
+export type Placement = 'top' | 'bottom' | 'left' | 'right' | 'free'
+export const PLACEMENTS: readonly Placement[] = ['top', 'bottom', 'left', 'right', 'free']
+
+export interface FocusSettings {
+  enabled: boolean
+  strict: boolean
+  sites: string[]
+}
+
+export interface DsnSettings {
+  dynamicMediaAccent: boolean
+  feedbackPromptsEnabled: boolean
+  /** Pure-black surfaces instead of DSN's near-black. */
+  amoled: boolean
+  placement: Placement
+  /** Used when placement is "free": notch centre-x and top-y as fractions of the viewport. */
+  freePosition: { x: number; y: number }
+  /** Opt-in. Sends track title/artist/duration to the lyrics provider. */
+  lyricsEnabled: boolean
+  focus: FocusSettings
+}
+
+export const DEFAULT_SETTINGS: DsnSettings = {
+  dynamicMediaAccent: true,
+  feedbackPromptsEnabled: true,
+  amoled: false,
+  placement: 'top',
+  freePosition: { x: 0.5, y: 0.04 },
+  lyricsEnabled: false,
+  focus: { enabled: false, strict: false, sites: [] },
+}
+
+const bool = (value: unknown, fallback: boolean) => (typeof value === 'boolean' ? value : fallback)
+const unit = (value: unknown, fallback: number) =>
+  typeof value === 'number' && Number.isFinite(value) ? Math.min(1, Math.max(0, value)) : fallback
+
+/** Validates anything read from storage. Unknown or malformed fields fall back to defaults. */
+export function sanitizeSettings(raw: unknown): DsnSettings {
+  const source = (raw && typeof raw === 'object' ? raw : {}) as Record<string, any>
+  const focus = (source.focus && typeof source.focus === 'object' ? source.focus : {}) as Record<string, any>
+  const sites = Array.isArray(focus.sites)
+    ? [...new Set(focus.sites.map((site: unknown) => normalizeHost(String(site))).filter((site): site is string => !!site))].slice(0, 200)
+    : []
+  const position = (source.freePosition && typeof source.freePosition === 'object' ? source.freePosition : {}) as Record<string, any>
+  return {
+    dynamicMediaAccent: bool(source.dynamicMediaAccent, DEFAULT_SETTINGS.dynamicMediaAccent),
+    feedbackPromptsEnabled: bool(source.feedbackPromptsEnabled, DEFAULT_SETTINGS.feedbackPromptsEnabled),
+    amoled: bool(source.amoled, DEFAULT_SETTINGS.amoled),
+    placement: PLACEMENTS.includes(source.placement) ? source.placement : DEFAULT_SETTINGS.placement,
+    freePosition: { x: unit(position.x, DEFAULT_SETTINGS.freePosition.x), y: unit(position.y, DEFAULT_SETTINGS.freePosition.y) },
+    lyricsEnabled: bool(source.lyricsEnabled, DEFAULT_SETTINGS.lyricsEnabled),
+    focus: { enabled: bool(focus.enabled, false), strict: bool(focus.strict, false), sites },
+  }
+}
+
+export async function loadSettings(): Promise<DsnSettings> {
+  try {
+    const stored = await chrome.storage.local.get(SETTINGS_KEY)
+    return sanitizeSettings(stored[SETTINGS_KEY])
+  } catch {
+    return structuredClone(DEFAULT_SETTINGS)
+  }
+}
+
+export async function saveSettings(patch: Partial<DsnSettings>): Promise<DsnSettings> {
+  const next = sanitizeSettings({ ...(await loadSettings()), ...patch })
+  await chrome.storage.local.set({ [SETTINGS_KEY]: next })
+  return next
+}
+
+export function watchSettings(callback: (settings: DsnSettings) => void): () => void {
+  const listener = (changes: Record<string, chrome.storage.StorageChange>, area: string) => {
+    if (area === 'local' && changes[SETTINGS_KEY]) callback(sanitizeSettings(changes[SETTINGS_KEY].newValue))
+  }
+  chrome.storage.onChanged.addListener(listener)
+  return () => chrome.storage.onChanged.removeListener(listener)
+}

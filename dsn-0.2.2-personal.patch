--- /dev/null
+++ b/src/shared/select.ts
@@ -0,0 +1,14 @@
+import type { SessionView } from './protocol.ts'
+
+/** A "playing" session that has stopped reporting (crashed or frozen tab) is treated as paused. */
+export const STALE_AFTER_MS = 90_000
+
+export function isLive(session: SessionView, now: number): boolean {
+  return session.playing && now - session.lastSeen < STALE_AFTER_MS
+}
+
+/** The session the notch should show: most recently started live playback, else the most recently touched paused one. */
+export function pickCurrent(sessions: readonly SessionView[], now: number): SessionView | null {
+  if (!sessions.length) return null
+  return [...sessions].sort((a, b) => Number(isLive(b, now)) - Number(isLive(a, now)) || b.updatedAt - a.updatedAt)[0] ?? null
+}

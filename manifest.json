{
  "manifest_version": 3,
  "name": "Dynamic Synthetic Notchland",
  "version": "0.2.3",
  "description": "A compact browser-native interface environment.",
  "permissions": ["downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "notchtab.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dynamic Synthetic Notchland"
  }
}
